<Item class="ModuleScript" referent="RBX1">
<Properties>
<string name="Name">GameConfig</string>
<ProtectedString name="Source"><![CDATA[
--[[
	GameConfig
	Every tunable number for the "Feed Big Bebeh" cookie game lives here.
	Tweak these values and the whole world rebuilds itself on the next run.
]]

local GameConfig = {}

-- Saving -------------------------------------------------------------------
GameConfig.SaveEnabled = true
GameConfig.DataStoreName = "BigBebehCookies_v2"
GameConfig.AutosaveInterval = 120

-- Big Bebeh's look ---------------------------------------------------------
-- Leave this empty to use the part-built Bebeh. To use your own artwork,
-- upload the picture to Roblox (Create → Decals), then paste its id here as
-- "rbxassetid://0000000000" and every Bebeh becomes a cutout of your image.
-- A Model named "BigBebeh" in ServerStorage beats both of these.
GameConfig.BebehImageId = ""
GameConfig.BebehImageAspect = 1152 / 1320 -- width / height of the artwork

-- Gameplay tuning ----------------------------------------------------------
GameConfig.FeedRadius = 16 -- studs; walk this close to Big Bebeh to auto-feed
GameConfig.FeedInterval = 0.3 -- seconds between auto-feed checks
GameConfig.CookieRespawnTime = 5 -- seconds before a picked-up cookie comes back
GameConfig.CollectRange = 14 -- server-side sanity check on pickups
GameConfig.VoidY = -60 -- fall below this and you get placed back on your area
GameConfig.MagnetInterval = 0.15 -- seconds between magnet sweeps

-- World layout -------------------------------------------------------------
GameConfig.PlatformSize = Vector3.new(220, 6, 220)
GameConfig.AreaSpacing = 300 -- centre-to-centre distance along +X
GameConfig.BridgeWidth = 26

-- Areas --------------------------------------------------------------------
-- Feed the Bebeh in area N its HungerGoal to unlock area N + 1.
-- CarryCapacity is the base hand size once that area is unlocked; the
-- Bigger Hands upgrade multiplies it.
GameConfig.Areas = {
	{
		Name = "Cookie Nursery",
		FloorColor = Color3.fromRGB(126, 196, 122),
		AccentColor = Color3.fromRGB(255, 232, 120),
		CookieColor = Color3.fromRGB(214, 168, 106),
		CookieValue = 1,
		CookieCount = 40,
		CarryCapacity = 30,
		HungerGoal = 60,
		BebehName = "Baby Bebeh",
		BebehScale = 1,
	},
	{
		Name = "Sugar Sandbox",
		FloorColor = Color3.fromRGB(238, 205, 152),
		AccentColor = Color3.fromRGB(255, 170, 200),
		CookieColor = Color3.fromRGB(240, 214, 168),
		CookieValue = 4,
		CookieCount = 40,
		CarryCapacity = 120,
		HungerGoal = 400,
		BebehName = "Bigger Bebeh",
		BebehScale = 1.35,
	},
	{
		Name = "Frosting Fields",
		FloorColor = Color3.fromRGB(160, 214, 236),
		AccentColor = Color3.fromRGB(255, 255, 255),
		CookieColor = Color3.fromRGB(255, 236, 244),
		CookieValue = 15,
		CookieCount = 40,
		CarryCapacity = 450,
		HungerGoal = 1800,
		BebehName = "Chonky Bebeh",
		BebehScale = 1.75,
	},
	{
		Name = "Choco Chip Canyon",
		FloorColor = Color3.fromRGB(120, 84, 60),
		AccentColor = Color3.fromRGB(196, 132, 88),
		CookieColor = Color3.fromRGB(96, 62, 40),
		CookieValue = 60,
		CookieCount = 40,
		CarryCapacity = 1800,
		HungerGoal = 9000,
		BebehName = "Mega Bebeh",
		BebehScale = 2.2,
	},
	{
		Name = "Golden Crumb Summit",
		FloorColor = Color3.fromRGB(226, 186, 84),
		AccentColor = Color3.fromRGB(255, 246, 190),
		CookieColor = Color3.fromRGB(255, 214, 88),
		CookieValue = 250,
		CookieCount = 40,
		CarryCapacity = 7500,
		HungerGoal = 45000,
		BebehName = "BIG BEBEH",
		BebehScale = 2.8,
	},
}

-- Upgrades -----------------------------------------------------------------
-- Bought with Sprinkles, which you earn by feeding Big Bebeh.
GameConfig.SprinklesPerCookieFed = 1

GameConfig.BaseWalkSpeed = 16
GameConfig.CapacityPerLevel = 0.2 -- +20% of the area's base capacity per level
GameConfig.SpeedPerLevel = 2 -- +2 walk speed per level
GameConfig.MagnetBaseRadius = 9 -- radius at level 1
GameConfig.MagnetPerLevel = 2.5 -- extra radius for each level after the first
GameConfig.LuckPerLevel = 0.05 -- +5% chance of a double-value cookie per level

GameConfig.Upgrades = {
	{
		Id = "Capacity",
		Name = "Bigger Hands",
		Icon = "🧤",
		Blurb = "Carry more cookies each trip",
		MaxLevel = 20,
		BaseCost = 40,
		CostMultiplier = 1.42,
	},
	{
		Id = "Speed",
		Name = "Sugar Rush",
		Icon = "👟",
		Blurb = "Run faster between cookies",
		MaxLevel = 15,
		BaseCost = 60,
		CostMultiplier = 1.5,
	},
	{
		Id = "Magnet",
		Name = "Cookie Magnet",
		Icon = "🧲",
		Blurb = "Suck up cookies without touching them",
		MaxLevel = 12,
		BaseCost = 120,
		CostMultiplier = 1.55,
	},
	{
		Id = "Luck",
		Name = "Double Chip",
		Icon = "🍀",
		Blurb = "Chance for a cookie to count twice",
		MaxLevel = 10,
		BaseCost = 200,
		CostMultiplier = 1.6,
	},
}

-- Rebirth ------------------------------------------------------------------
-- Once BIG BEBEH is full you can start over. Areas reset, but you keep every
-- upgrade and sprinkle, plus a permanent multiplier on everything you collect.
GameConfig.RebirthMultiplierPerLevel = 0.5
GameConfig.RebirthSprinkleBonus = 2500

-- Helpers ------------------------------------------------------------------

function GameConfig.getAreaCenter(areaIndex: number): Vector3
	return Vector3.new((areaIndex - 1) * GameConfig.AreaSpacing, 0, 0)
end

function GameConfig.getUpgrade(id: string)
	for _, upgrade in GameConfig.Upgrades do
		if upgrade.Id == id then
			return upgrade
		end
	end
	return nil
end

function GameConfig.getUpgradeLevel(state: any, id: string): number
	return (state.upgrades and state.upgrades[id]) or 0
end

-- Cost of the NEXT level, given how many you already own.
function GameConfig.getUpgradeCost(upgrade: any, currentLevel: number): number
	return math.floor(upgrade.BaseCost * upgrade.CostMultiplier ^ currentLevel)
end

function GameConfig.getCapacity(state: any): number
	local area = GameConfig.Areas[math.clamp(state.maxArea or 1, 1, #GameConfig.Areas)]
	local level = GameConfig.getUpgradeLevel(state, "Capacity")
	return math.floor(area.CarryCapacity * (1 + GameConfig.CapacityPerLevel * level))
end

function GameConfig.getWalkSpeed(state: any): number
	return GameConfig.BaseWalkSpeed + GameConfig.SpeedPerLevel * GameConfig.getUpgradeLevel(state, "Speed")
end

-- Level 0 means no magnet at all.
function GameConfig.getMagnetRadius(state: any): number
	local level = GameConfig.getUpgradeLevel(state, "Magnet")
	if level <= 0 then
		return 0
	end
	return GameConfig.MagnetBaseRadius + GameConfig.MagnetPerLevel * (level - 1)
end

function GameConfig.getLuckChance(state: any): number
	return math.min(1, GameConfig.LuckPerLevel * GameConfig.getUpgradeLevel(state, "Luck"))
end

function GameConfig.getRebirthMultiplier(state: any): number
	return 1 + GameConfig.RebirthMultiplierPerLevel * (state.rebirths or 0)
end

function GameConfig.canRebirth(state: any): boolean
	local last = #GameConfig.Areas
	return (state.fed and state.fed[last] or 0) >= GameConfig.Areas[last].HungerGoal
end

-- Short "what does this level do" text for the shop.
function GameConfig.describeUpgrade(state: any, upgrade: any): string
	local level = GameConfig.getUpgradeLevel(state, upgrade.Id)
	if upgrade.Id == "Capacity" then
		return `Hands: {GameConfig.abbreviate(GameConfig.getCapacity(state))}`
	elseif upgrade.Id == "Speed" then
		return `Speed: {GameConfig.getWalkSpeed(state)}`
	elseif upgrade.Id == "Magnet" then
		local radius = GameConfig.getMagnetRadius(state)
		return radius > 0 and `Reach: {math.floor(radius)} studs` or "Not bought yet"
	elseif upgrade.Id == "Luck" then
		return `Double chance: {math.floor(GameConfig.getLuckChance(state) * 100)}%`
	end
	return `Level {level}`
end

-- Turns 45000 into "45K" so the HUD never overflows.
function GameConfig.abbreviate(n: number): string
	local suffixes = { "", "K", "M", "B", "T" }
	local tier = 0
	local value = n
	while value >= 1000 and tier < #suffixes - 1 do
		value /= 1000
		tier += 1
	end
	if tier == 0 then
		return string.format("%d", value)
	end
	-- "45.0K" reads worse than "45K", so drop a trailing zero decimal.
	local text = string.gsub(string.format("%.1f", value), "%.0$", "")
	return text .. suffixes[tier + 1]
end

return GameConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2">
<Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[
--[[
	Remotes
	Creates the RemoteEvent folder on the server, waits for it on the client.
	require() this from either side and index the events by name.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "BigBebehRemotes"
local REMOTE_NAMES = {
	"SyncState", -- server -> client: the player's full progress table
	"Toast", -- server -> client: a short message for the notification stack
	"CookiePop", -- server -> client: "+N" floating text at a world position
	"FeedBurst", -- server -> client: make a Bebeh bounce and spit crumbs
	"BuyUpgrade", -- client -> server: "I want the next level of this upgrade"
	"Rebirth", -- client -> server: "start me over for the multiplier"
}

local folder: Folder

if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, name in REMOTE_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local Remotes = {}
for _, name in REMOTE_NAMES do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX12">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX7">
<Properties>
<string name="Name">BigBebehGame</string>
<ProtectedString name="Source"><![CDATA[
--[[
	Big Bebeh — Cookie Collector (server)

	The loop:
	  1. Cookies lie around each area. Walk over one to pick it up.
	  2. Your hands only hold so many; when they are full, go feed Big Bebeh.
	  3. Stand on his pad and he eats everything you are carrying, paying out
	     Sprinkles as he goes.
	  4. Fill his hunger bar and the gate to the next area opens for you.
	  5. Spend Sprinkles at the shop on hands, speed, magnet and luck.
	  6. Once BIG BEBEH is full, rebirth for a permanent multiplier.

	All tuning lives in ReplicatedStorage/BigBebehShared/GameConfig.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)
local Remotes = require(ReplicatedStorage.BigBebehShared.Remotes)
local PlayerState = require(script.PlayerState)
local WorldBuilder = require(script.WorldBuilder)

local COOKIE_COLOR = Color3.fromRGB(255, 226, 140)
local LUCKY_COLOR = Color3.fromRGB(150, 255, 170)
local UNLOCK_COLOR = Color3.fromRGB(140, 255, 170)
local SPRINKLE_COLOR = Color3.fromRGB(255, 150, 220)
local DENY_COLOR = Color3.fromRGB(255, 150, 130)

local world = WorldBuilder.build()

local cookiePool = Instance.new("Folder")
cookiePool.Name = "CookiePool"
cookiePool.Parent = ServerStorage

-- Cookies grouped by area, so the magnet only ever scans one platform's worth.
local cookiesByArea: { [number]: { Model } } = {}

-- Cookie spawning ----------------------------------------------------------

-- Somewhere on the platform that is not on top of the Bebeh or his feed pad.
local function randomCookiePosition(areaIndex: number): Vector3
	local center = GameConfig.getAreaCenter(areaIndex)
	local halfX = GameConfig.PlatformSize.X / 2 - 22
	local halfZ = GameConfig.PlatformSize.Z / 2 - 22

	for _ = 1, 12 do
		local pos = center + Vector3.new(math.random(-halfX, halfX), 2.4, math.random(-halfZ, halfZ))
		-- The Bebeh stands at z = -70 relative to the area centre.
		if (pos - (center + Vector3.new(0, 0, -70))).Magnitude > GameConfig.FeedRadius + 22 then
			return pos
		end
	end
	return center + Vector3.new(math.random(-halfX, halfX), 2.4, math.random(20, halfZ))
end

local function createCookie(areaIndex: number): Model
	local cfg = GameConfig.Areas[areaIndex]

	local model = Instance.new("Model")
	model.Name = "Cookie"

	local disc = Instance.new("Part")
	disc.Name = "Disc"
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.6, 3.2, 3.2)
	disc.Color = cfg.CookieColor
	disc.Material = Enum.Material.Sand
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanTouch = true
	disc.Parent = model
	model.PrimaryPart = disc

	-- Chocolate chips scattered on the top face.
	for i = 1, 4 do
		local angle = (i / 4) * math.pi * 2 + math.random() * 0.6
		local chip = Instance.new("Part")
		chip.Name = "Chip"
		chip.Shape = Enum.PartType.Ball
		chip.Size = Vector3.new(0.7, 0.7, 0.7)
		chip.Color = cfg.CookieColor:Lerp(Color3.fromRGB(40, 24, 14), 0.75)
		chip.Material = Enum.Material.SmoothPlastic
		chip.Anchored = true
		chip.CanCollide = false
		chip.CanTouch = false
		chip.CanQuery = false
		chip.Parent = model
		chip:SetAttribute("Offset", Vector3.new(math.cos(angle) * 0.9, 0.35, math.sin(angle) * 0.9))
	end

	model:SetAttribute("AreaIndex", areaIndex)
	model:SetAttribute("Value", cfg.CookieValue)

	return model
end

-- Places a cookie model at a fresh random spot in its area.
local function placeCookie(model: Model)
	local areaIndex = model:GetAttribute("AreaIndex") :: number
	local pos = randomCookiePosition(areaIndex)
	local disc = model.PrimaryPart :: Part
	-- The cylinder's axis runs along its local X, so roll it 90° to lie flat.
	disc.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	for _, chip in model:GetChildren() do
		if chip:IsA("BasePart") and chip.Name == "Chip" then
			chip.Position = pos + (chip:GetAttribute("Offset") :: Vector3)
		end
	end
	model.Parent = world.cookiesFolder
end

-- Player helpers -----------------------------------------------------------

local lastToast: { [Player]: number } = {}

local function toast(player: Player, message: string, color: Color3?, throttleSeconds: number?)
	if throttleSeconds then
		local now = os.clock()
		if lastToast[player] and now - lastToast[player] < throttleSeconds then
			return
		end
		lastToast[player] = now
	end
	Remotes.Toast:FireClient(player, message, color or Color3.fromRGB(255, 255, 255))
end

local function applyWalkSpeed(player: Player, state: any)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = GameConfig.getWalkSpeed(state)
	end
end

local function sync(player: Player)
	local state = PlayerState.get(player)
	if not state then
		return
	end

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Cookies.Value = state.carried
		stats.Sprinkles.Value = state.sprinkles
		stats.Area.Value = state.maxArea
		stats.Rebirths.Value = state.rebirths
	end

	Remotes.SyncState:FireClient(player, {
		maxArea = state.maxArea,
		carried = state.carried,
		capacity = GameConfig.getCapacity(state),
		fed = state.fed,
		totalFed = state.totalFed,
		sprinkles = state.sprinkles,
		upgrades = state.upgrades,
		rebirths = state.rebirths,
	})
end

local function areaAtPosition(position: Vector3): number
	local index = math.round(position.X / GameConfig.AreaSpacing) + 1
	return math.clamp(index, 1, #GameConfig.Areas)
end

local function teleportToArea(player: Player, areaIndex: number)
	local character = player.Character
	if not character then
		return
	end
	local center = GameConfig.getAreaCenter(areaIndex)
	character:PivotTo(CFrame.new(center + Vector3.new(0, 6, 70)))
end

-- Collecting ---------------------------------------------------------------

-- `allowedRange` lets the magnet reach further than a plain footstep pickup.
local function collect(player: Player, model: Model, allowedRange: number?)
	local state = PlayerState.get(player)
	if not state then
		return
	end

	local areaIndex = model:GetAttribute("AreaIndex") :: number
	if state.maxArea < areaIndex then
		toast(player, `Feed {GameConfig.Areas[areaIndex - 1].BebehName} first!`, nil, 3)
		return
	end

	local capacity = GameConfig.getCapacity(state)
	if state.carried >= capacity then
		toast(player, "Hands full! Go feed Big Bebeh 🍪", Color3.fromRGB(255, 180, 120), 3)
		return
	end

	-- Distance check so a mis-fired Touched can't grab a cookie across the map.
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not model.PrimaryPart then
		return
	end
	if (root.Position - model.PrimaryPart.Position).Magnitude > (allowedRange or GameConfig.CollectRange) then
		return
	end

	local value = (model:GetAttribute("Value") :: number) * GameConfig.getRebirthMultiplier(state)
	local lucky = math.random() < GameConfig.getLuckChance(state)
	if lucky then
		value *= 2
	end

	local gained = math.min(math.floor(value), capacity - state.carried)
	state.carried += gained

	Remotes.CookiePop:FireClient(
		player,
		model.PrimaryPart.Position,
		lucky and `+{GameConfig.abbreviate(gained)} x2!` or `+{GameConfig.abbreviate(gained)}`,
		lucky and LUCKY_COLOR or COOKIE_COLOR
	)
	sync(player)

	-- Hide it, then bring it back somewhere else on the same platform.
	model.Parent = cookiePool
	task.delay(GameConfig.CookieRespawnTime, function()
		if model.Parent == cookiePool then
			placeCookie(model)
		end
	end)
end

local function armCookie(model: Model)
	local disc = model.PrimaryPart :: Part
	disc.Touched:Connect(function(hit)
		-- Ignore touches while the cookie is pooled or already being claimed.
		if model.Parent ~= world.cookiesFolder then
			return
		end
		local character = hit.Parent
		if not character or not character:FindFirstChildOfClass("Humanoid") then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			collect(player, model)
		end
	end)
end

for areaIndex = 1, #GameConfig.Areas do
	cookiesByArea[areaIndex] = {}
	for _ = 1, GameConfig.Areas[areaIndex].CookieCount do
		local cookie = createCookie(areaIndex)
		placeCookie(cookie)
		armCookie(cookie)
		table.insert(cookiesByArea[areaIndex], cookie)
	end
end

-- Magnet -------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(GameConfig.MagnetInterval)
		for player, state in PlayerState.all() do
			local radius = GameConfig.getMagnetRadius(state)
			if radius <= 0 then
				continue
			end

			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root or state.carried >= GameConfig.getCapacity(state) then
				continue
			end

			local areaIndex = areaAtPosition(root.Position)
			if areaIndex > state.maxArea then
				continue
			end

			for _, cookie in cookiesByArea[areaIndex] do
				if cookie.Parent ~= world.cookiesFolder or not cookie.PrimaryPart then
					continue
				end
				if (cookie.PrimaryPart.Position - root.Position).Magnitude <= radius then
					collect(player, cookie, radius + 6)
					if state.carried >= GameConfig.getCapacity(state) then
						break
					end
				end
			end
		end
	end
end)

-- Feeding ------------------------------------------------------------------

local bebehs: { [number]: Model } = {}
for _, model in CollectionService:GetTagged("BigBebeh") do
	bebehs[model:GetAttribute("AreaIndex") :: number] = model
end

local function feed(player: Player, areaIndex: number)
	local state = PlayerState.get(player)
	if not state or state.carried <= 0 then
		return
	end

	local cfg = GameConfig.Areas[areaIndex]
	local remaining = cfg.HungerGoal - state.fed[areaIndex]
	if remaining <= 0 then
		return
	end

	local amount = math.min(state.carried, remaining)
	state.carried -= amount
	state.fed[areaIndex] += amount
	state.totalFed += amount

	local earned = math.floor(amount * GameConfig.SprinklesPerCookieFed * GameConfig.getRebirthMultiplier(state))
	state.sprinkles += earned

	local bebeh = bebehs[areaIndex]
	if bebeh then
		Remotes.FeedBurst:FireClient(player, bebeh, amount)
		if earned > 0 then
			Remotes.CookiePop:FireClient(
				player,
				bebeh:GetPivot().Position,
				`+{GameConfig.abbreviate(earned)} ✨`,
				SPRINKLE_COLOR
			)
		end
	end

	if state.fed[areaIndex] >= cfg.HungerGoal then
		if areaIndex < #GameConfig.Areas and state.maxArea == areaIndex then
			state.maxArea = areaIndex + 1
			local nextCfg = GameConfig.Areas[state.maxArea]
			toast(player, `🎉 {nextCfg.Name} unlocked!`, UNLOCK_COLOR)
		elseif areaIndex == #GameConfig.Areas then
			toast(player, "🏆 BIG BEBEH IS FULL — rebirth is ready!", UNLOCK_COLOR)
		end
	end

	sync(player)
end

task.spawn(function()
	while true do
		task.wait(GameConfig.FeedInterval)
		for player, state in PlayerState.all() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end

			if root.Position.Y < GameConfig.VoidY then
				teleportToArea(player, math.min(state.maxArea, areaAtPosition(root.Position)))
				continue
			end

			if state.carried <= 0 then
				continue
			end

			for areaIndex = 1, state.maxArea do
				local bebeh = bebehs[areaIndex]
				if not bebeh or state.fed[areaIndex] >= GameConfig.Areas[areaIndex].HungerGoal then
					continue
				end
				-- Flat distance: his pivot sits well above the player's head.
				local offset = bebeh:GetPivot().Position - root.Position
				if Vector2.new(offset.X, offset.Z).Magnitude <= GameConfig.FeedRadius + 8 then
					feed(player, areaIndex)
					break
				end
			end
		end
	end
end)

-- Shop and rebirth ---------------------------------------------------------

Remotes.BuyUpgrade.OnServerEvent:Connect(function(player, upgradeId)
	if type(upgradeId) ~= "string" then
		return
	end
	local state = PlayerState.get(player)
	local upgrade = GameConfig.getUpgrade(upgradeId)
	if not state or not upgrade then
		return
	end

	local level = GameConfig.getUpgradeLevel(state, upgradeId)
	if level >= upgrade.MaxLevel then
		toast(player, `{upgrade.Name} is already maxed out!`, DENY_COLOR, 1)
		return
	end

	local cost = GameConfig.getUpgradeCost(upgrade, level)
	if state.sprinkles < cost then
		toast(player, `Need {GameConfig.abbreviate(cost - state.sprinkles)} more sprinkles`, DENY_COLOR, 1)
		return
	end

	state.sprinkles -= cost
	state.upgrades[upgradeId] = level + 1
	applyWalkSpeed(player, state)
	toast(player, `{upgrade.Icon} {upgrade.Name} → level {level + 1}`, SPRINKLE_COLOR)
	sync(player)
end)

Remotes.Rebirth.OnServerEvent:Connect(function(player)
	local state = PlayerState.get(player)
	if not state then
		return
	end
	if not GameConfig.canRebirth(state) then
		toast(player, "Fill BIG BEBEH first to rebirth!", DENY_COLOR, 1)
		return
	end

	state.rebirths += 1
	state.maxArea = 1
	state.carried = 0
	for i = 1, #GameConfig.Areas do
		state.fed[i] = 0
	end
	state.sprinkles += GameConfig.RebirthSprinkleBonus

	teleportToArea(player, 1)
	applyWalkSpeed(player, state)
	toast(
		player,
		`⭐ Rebirth {state.rebirths}! Everything you collect is now x{GameConfig.getRebirthMultiplier(state)}`,
		UNLOCK_COLOR
	)
	sync(player)
end)

-- Players ------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local state = PlayerState.load(player)

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Cookies", "Sprinkles", "Area", "Rebirths" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		applyWalkSpeed(player, state)
		sync(player)
	end)

	applyWalkSpeed(player, state)
	sync(player)
	toast(player, `Welcome! Collect cookies and feed {GameConfig.Areas[state.maxArea].BebehName}.`, COOKIE_COLOR)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	lastToast[player] = nil
	PlayerState.release(player)
end)

-- The client pings this once its UI is built, so it never misses the first sync.
Remotes.SyncState.OnServerEvent:Connect(function(player)
	sync(player)
end)

task.spawn(function()
	while true do
		task.wait(GameConfig.AutosaveInterval)
		for player in PlayerState.all() do
			PlayerState.save(player)
		end
	end
end)

game:BindToClose(function()
	for player in PlayerState.all() do
		PlayerState.save(player)
	end
end)
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX4">
<Properties>
<string name="Name">PlayerState</string>
<ProtectedString name="Source"><![CDATA[
--[[
	PlayerState
	Per-player progress, with optional DataStore persistence.

	state = {
		maxArea   = 1,          -- highest area unlocked
		carried   = 0,          -- cookies currently in hand
		fed       = { 12, 0 },  -- cookies fed to each area's Bebeh
		totalFed  = 12,
		sprinkles = 340,        -- upgrade currency, earned by feeding
		upgrades  = { Capacity = 3, Speed = 1 },
		rebirths  = 0,
	}
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)

local PlayerState = {}

local states: { [Player]: any } = {}

local store: DataStore? = nil
if GameConfig.SaveEnabled then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn(`[BigBebeh] DataStore unavailable, running without saves: {result}`)
	end
end

local function defaultState()
	local upgrades = {}
	for _, upgrade in GameConfig.Upgrades do
		upgrades[upgrade.Id] = 0
	end
	return {
		maxArea = 1,
		carried = 0,
		fed = table.create(#GameConfig.Areas, 0),
		totalFed = 0,
		sprinkles = 0,
		upgrades = upgrades,
		rebirths = 0,
	}
end

-- Anything loaded from a DataStore is untrusted: an older save may be missing
-- fields, or have more/fewer areas than the current config.
local function sanitize(raw: any)
	local state = defaultState()
	if type(raw) ~= "table" then
		return state
	end

	if type(raw.maxArea) == "number" then
		state.maxArea = math.clamp(math.floor(raw.maxArea), 1, #GameConfig.Areas)
	end
	if type(raw.rebirths) == "number" and raw.rebirths >= 0 then
		state.rebirths = math.floor(raw.rebirths)
	end
	if type(raw.sprinkles) == "number" and raw.sprinkles >= 0 then
		state.sprinkles = math.floor(raw.sprinkles)
	end

	-- Upgrades are read before `carried`, because carry capacity depends on them.
	if type(raw.upgrades) == "table" then
		for _, upgrade in GameConfig.Upgrades do
			local level = raw.upgrades[upgrade.Id]
			if type(level) == "number" and level >= 0 then
				state.upgrades[upgrade.Id] = math.min(math.floor(level), upgrade.MaxLevel)
			end
		end
	end

	if type(raw.carried) == "number" and raw.carried >= 0 then
		state.carried = math.min(math.floor(raw.carried), GameConfig.getCapacity(state))
	end
	if type(raw.fed) == "table" then
		for i = 1, #GameConfig.Areas do
			local value = raw.fed[i]
			if type(value) == "number" and value >= 0 then
				state.fed[i] = math.min(math.floor(value), GameConfig.Areas[i].HungerGoal)
			end
		end
	end
	if type(raw.totalFed) == "number" and raw.totalFed >= 0 then
		state.totalFed = math.floor(raw.totalFed)
	end

	return state
end

local function key(player: Player): string
	return `player_{player.UserId}`
end

function PlayerState.load(player: Player)
	local raw = nil
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			raw = result
		else
			warn(`[BigBebeh] Load failed for {player.Name}: {result}`)
		end
	end

	local state = sanitize(raw)
	states[player] = state
	return state
end

function PlayerState.get(player: Player)
	return states[player]
end

function PlayerState.save(player: Player)
	local state = states[player]
	if not state or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), state)
	end)
	if not ok then
		warn(`[BigBebeh] Save failed for {player.Name}: {err}`)
	end
end

function PlayerState.release(player: Player)
	PlayerState.save(player)
	states[player] = nil
end

function PlayerState.all()
	return states
end

return PlayerState
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5">
<Properties>
<string name="Name">WorldBuilder</string>
<ProtectedString name="Source"><![CDATA[
--[[
	WorldBuilder
	Generates the whole map from GameConfig: one floating platform per area, a
	bridge between each pair, a locked gate on every bridge, and a Big Bebeh
	waiting to be fed on each platform.

	Everything lands in Workspace.BigBebehWorld. It is rebuilt from scratch on
	each server start, so you can safely delete it in Studio and hit Play again.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)
local BebehBuilder = require(script.Parent.BebehBuilder)

local WorldBuilder = {}

local WORLD_NAME = "BigBebehWorld"

local function makeAnchoredPart(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function makeSign(text: string, size: UDim2, adornee: BasePart, offsetY: number): BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Sign"
	billboard.Size = size
	billboard.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	billboard.MaxDistance = 300
	billboard.Adornee = adornee

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Parent = billboard

	billboard.Parent = adornee
	return billboard
end

-- A little market stall where Sprinkles get spent.
local function buildShop(center: Vector3, cfg: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Shop"
	folder.Parent = parent

	local base = center + Vector3.new(62, 0, 62)

	makeAnchoredPart("Counter", Vector3.new(16, 6, 6), CFrame.new(base + Vector3.new(0, 3, 0)), Color3.fromRGB(168, 128, 92), folder).Material =
		Enum.Material.WoodPlanks
	for _, side in { -1, 1 } do
		makeAnchoredPart(
			"Post",
			Vector3.new(1.2, 14, 1.2),
			CFrame.new(base + Vector3.new(side * 7, 7, -2.6)),
			Color3.fromRGB(140, 104, 74),
			folder
		)
	end

	-- Striped awning.
	for i = -3, 3 do
		makeAnchoredPart(
			"Awning",
			Vector3.new(2.4, 0.6, 9),
			CFrame.new(base + Vector3.new(i * 2.4, 14.5, 0)) * CFrame.Angles(math.rad(-16), 0, 0),
			(i % 2 == 0) and Color3.fromRGB(240, 96, 110) or Color3.fromRGB(250, 246, 238),
			folder
		)
	end

	local sign = makeAnchoredPart(
		"ShopSign",
		Vector3.new(1, 1, 1),
		CFrame.new(base + Vector3.new(0, 19, 0)),
		cfg.AccentColor,
		folder
	)
	sign.Transparency = 1
	sign.CanCollide = false
	makeSign("🛒 UPGRADE SHOP", UDim2.fromScale(16, 4), sign, 0)

	-- Walking up opens the same panel as the on-screen button.
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open shop"
	prompt.ObjectText = "Upgrades"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 16
	prompt.Parent = folder:FindFirstChild("Counter")
	CollectionService:AddTag(prompt, "ShopPrompt")

	return folder
end

-- One platform, its fence, its name sign and its Bebeh.
local function buildArea(areaIndex: number, parent: Instance)
	local cfg = GameConfig.Areas[areaIndex]
	local center = GameConfig.getAreaCenter(areaIndex)
	local size = GameConfig.PlatformSize

	local folder = Instance.new("Folder")
	folder.Name = `Area{areaIndex}_{cfg.Name}`
	folder.Parent = parent

	-- Floor. Its top surface sits exactly at Y = 0.
	local floor = makeAnchoredPart(
		"Floor",
		size,
		CFrame.new(center + Vector3.new(0, -size.Y / 2, 0)),
		cfg.FloorColor,
		folder
	)
	floor.Material = Enum.Material.Grass

	-- A skirt underneath so the platform reads as a floating island.
	makeAnchoredPart(
		"Base",
		Vector3.new(size.X * 0.82, 22, size.Z * 0.82),
		CFrame.new(center + Vector3.new(0, -size.Y - 11, 0)),
		cfg.FloorColor:Lerp(Color3.new(0, 0, 0), 0.4),
		folder
	).Material = Enum.Material.Slate

	-- Low fence around the rim so nobody walks off by accident.
	local fenceHeight = 5
	for _, sz in { -1, 1 } do
		makeAnchoredPart(
			"Fence",
			Vector3.new(size.X, fenceHeight, 2),
			CFrame.new(center + Vector3.new(0, fenceHeight / 2, sz * size.Z / 2)),
			cfg.AccentColor,
			folder
		)
	end

	-- The +X and -X walls have a doorway cut into them wherever a bridge lands:
	-- one on -X unless this is the first area, one on +X unless it is the last.
	local sideRun = (size.Z - GameConfig.BridgeWidth) / 2
	local hasBridge = { [-1] = areaIndex > 1, [1] = areaIndex < #GameConfig.Areas }
	for _, sx in { -1, 1 } do
		if hasBridge[sx] then
			for _, sz in { -1, 1 } do
				makeAnchoredPart(
					"Fence",
					Vector3.new(2, fenceHeight, sideRun),
					CFrame.new(
						center
							+ Vector3.new(sx * size.X / 2, fenceHeight / 2, sz * (GameConfig.BridgeWidth + sideRun) / 2)
					),
					cfg.AccentColor,
					folder
				)
			end
		else
			makeAnchoredPart(
				"Fence",
				Vector3.new(2, fenceHeight, size.Z),
				CFrame.new(center + Vector3.new(sx * size.X / 2, fenceHeight / 2, 0)),
				cfg.AccentColor,
				folder
			)
		end
	end

	-- Area name floating over the middle of the platform.
	local marker = makeAnchoredPart(
		"NameMarker",
		Vector3.new(1, 1, 1),
		CFrame.new(center + Vector3.new(0, 26, 60)),
		cfg.AccentColor,
		folder
	)
	marker.Transparency = 1
	marker.CanCollide = false
	makeSign(`{areaIndex}. {cfg.Name}`, UDim2.fromScale(24, 5), marker, 0)

	-- Big Bebeh, at the back of the platform, facing the middle.
	local bebehPos = center + Vector3.new(0, 0, -70)
	local bebeh = BebehBuilder.build(areaIndex, cfg, CFrame.lookAt(bebehPos, bebehPos + Vector3.new(0, 0, 1)))
	bebeh.Parent = folder

	-- A soft glowing pad so players know where to stand to feed him.
	local diameter = GameConfig.FeedRadius * 2
	local pad = makeAnchoredPart(
		"FeedPad",
		Vector3.new(0.4, diameter, diameter),
		CFrame.new(bebehPos + Vector3.new(0, 0.2, 8)) * CFrame.Angles(0, 0, math.rad(90)),
		cfg.AccentColor,
		folder
	)
	pad.Shape = Enum.PartType.Cylinder
	pad.CanCollide = false
	pad.CanTouch = false
	pad.Material = Enum.Material.Neon
	pad.Transparency = 0.6

	buildShop(center, cfg, folder)

	return { folder = folder, bebeh = bebeh, center = center }
end

-- The bridge from `areaIndex` to `areaIndex + 1`, plus the gate that blocks it.
local function buildBridge(areaIndex: number, parent: Instance)
	local fromCenter = GameConfig.getAreaCenter(areaIndex)
	local nextCfg = GameConfig.Areas[areaIndex + 1]
	local size = GameConfig.PlatformSize
	local gapLength = GameConfig.AreaSpacing - size.X

	local folder = Instance.new("Folder")
	folder.Name = `Bridge{areaIndex}to{areaIndex + 1}`
	folder.Parent = parent

	local bridgeCenter = fromCenter + Vector3.new(size.X / 2 + gapLength / 2, -1.5, 0)
	makeAnchoredPart(
		"Deck",
		Vector3.new(gapLength, 3, GameConfig.BridgeWidth),
		CFrame.new(bridgeCenter),
		Color3.fromRGB(168, 128, 92),
		folder
	).Material = Enum.Material.WoodPlanks

	for _, sz in { -1, 1 } do
		makeAnchoredPart(
			"Rail",
			Vector3.new(gapLength, 4, 1.5),
			CFrame.new(bridgeCenter + Vector3.new(0, 3, sz * GameConfig.BridgeWidth / 2)),
			Color3.fromRGB(120, 88, 62),
			folder
		)
	end

	-- The gate. Solid until this player has fed the Bebeh behind them; the
	-- client turns it off locally once the area is unlocked.
	local gate = makeAnchoredPart(
		"Gate",
		Vector3.new(2, 24, GameConfig.BridgeWidth + 3),
		CFrame.new(fromCenter + Vector3.new(size.X / 2 + 3, 12, 0)),
		nextCfg.AccentColor,
		folder
	)
	gate.Material = Enum.Material.ForceField
	gate.Transparency = 0.35
	gate.CanCollide = true
	gate:SetAttribute("AreaIndex", areaIndex + 1) -- the area this gate leads INTO
	CollectionService:AddTag(gate, "AreaGate")

	makeSign(`🔒 {nextCfg.Name}`, UDim2.fromScale(20, 6), gate, 16)

	return folder
end

function WorldBuilder.build()
	local existing = workspace:FindFirstChild(WORLD_NAME)
	if existing then
		existing:Destroy()
	end
	-- Studio's default baseplate would sit in the middle of everything.
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	local world = Instance.new("Folder")
	world.Name = WORLD_NAME
	world.Parent = workspace

	local areasFolder = Instance.new("Folder")
	areasFolder.Name = "Areas"
	areasFolder.Parent = world

	local cookiesFolder = Instance.new("Folder")
	cookiesFolder.Name = "Cookies"
	cookiesFolder.Parent = world

	local areas = {}
	for i = 1, #GameConfig.Areas do
		areas[i] = buildArea(i, areasFolder)
		if i < #GameConfig.Areas then
			buildBridge(i, areasFolder)
		end
	end

	-- Spawn everyone at the front of area 1.
	for _, old in workspace:GetDescendants() do
		if old:IsA("SpawnLocation") and not old:IsDescendantOf(world) then
			old:Destroy()
		end
	end
	local spawnPart = Instance.new("SpawnLocation")
	spawnPart.Name = "BebehSpawn"
	spawnPart.Size = Vector3.new(12, 1, 12)
	spawnPart.CFrame = CFrame.new(GameConfig.getAreaCenter(1) + Vector3.new(0, 0.5, 80))
	spawnPart.Anchored = true
	spawnPart.Color = GameConfig.Areas[1].AccentColor
	spawnPart.Material = Enum.Material.Neon
	spawnPart.Duration = 0
	spawnPart.Parent = world

	return {
		world = world,
		areas = areas,
		cookiesFolder = cookiesFolder,
	}
end

return WorldBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6">
<Properties>
<string name="Name">BebehBuilder</string>
<ProtectedString name="Source"><![CDATA[
--[[
	BebehBuilder
	Builds Big Bebeh: a chunky rounded brown head, long floppy yellow ears,
	sleepy arced eyes, blushy cheeks, a blue bib and a big blue pacifier.

	Three ways to get a Bebeh, in priority order:
	  1. A Model named "BigBebeh" in ServerStorage — cloned and scaled.
	  2. GameConfig.BebehImageId — a flat cutout of your own artwork.
	  3. Otherwise, the part-built one below.

	Roblox has no rounded-box primitive, so the chunky shapes here are built the
	way modelling packages do it: a core of slabs, cylinders along the edges and
	spheres at the corners. That is what stops him reading as a stack of bricks.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)

local BebehBuilder = {}

local BROWN = Color3.fromRGB(156, 112, 76)
local BROWN_DARK = Color3.fromRGB(120, 84, 56)
local EAR_YELLOW = Color3.fromRGB(250, 226, 72)
local EAR_YELLOW_DARK = Color3.fromRGB(222, 196, 48)
local BIB_BLUE = Color3.fromRGB(152, 216, 240)
local BIB_BLUE_LIGHT = Color3.fromRGB(196, 234, 250)
local PACI_BLUE = Color3.fromRGB(88, 152, 242)
local PACI_PURPLE = Color3.fromRGB(150, 120, 226)
local BLUSH = Color3.fromRGB(238, 138, 138)
local DIAPER = Color3.fromRGB(246, 244, 238)
local INK = Color3.fromRGB(18, 16, 16)

--[[
	Collects parts as we go. Every piece is authored around the origin with the
	face pointing down -Z, then the whole model is moved into place at the end.
]]
local function newBuilder(scale: number)
	local pieces: { Part } = {}

	local function s(n: number)
		return n * scale
	end

	local function add(name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Shape = shape or Enum.PartType.Block
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		table.insert(pieces, p)
		return p
	end

	-- A box with every edge and corner rounded off: 3 slabs + 12 edges + 8 corners.
	local function roundedBox(name: string, size: Vector3, cf: CFrame, color: Color3, radius: number, material: Enum.Material?)
		local r = math.min(radius, size.X / 2, size.Y / 2, size.Z / 2)
		local ix, iy, iz = size.X - 2 * r, size.Y - 2 * r, size.Z - 2 * r
		local d = r * 2

		add(name, Vector3.new(size.X, iy, iz), cf, color, nil, material)
		add(name, Vector3.new(ix, size.Y, iz), cf, color, nil, material)
		add(name, Vector3.new(ix, iy, size.Z), cf, color, nil, material)

		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				-- Edges running along X, then Y, then Z.
				add(name, Vector3.new(ix, d, d), cf * CFrame.new(0, a * iy / 2, b * iz / 2), color, Enum.PartType.Cylinder, material)
				add(
					name,
					Vector3.new(iy, d, d),
					cf * CFrame.new(a * ix / 2, 0, b * iz / 2) * CFrame.Angles(0, 0, math.rad(90)),
					color,
					Enum.PartType.Cylinder,
					material
				)
				add(
					name,
					Vector3.new(iz, d, d),
					cf * CFrame.new(a * ix / 2, b * iy / 2, 0) * CFrame.Angles(0, math.rad(90), 0),
					color,
					Enum.PartType.Cylinder,
					material
				)
			end
		end

		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				for _, c in { -1, 1 } do
					add(
						name,
						Vector3.new(d, d, d),
						cf * CFrame.new(a * ix / 2, b * iy / 2, c * iz / 2),
						color,
						Enum.PartType.Ball,
						material
					)
				end
			end
		end
	end

	-- A flat slab with only its outline rounded — for ears, bibs and stripes.
	local function roundedPlate(name: string, size: Vector3, cf: CFrame, color: Color3, radius: number, material: Enum.Material?)
		local r = math.min(radius, size.X / 2, size.Y / 2)
		local ix, iy = size.X - 2 * r, size.Y - 2 * r
		local d = r * 2

		add(name, Vector3.new(size.X, iy, size.Z), cf, color, nil, material)
		add(name, Vector3.new(ix, size.Y, size.Z), cf, color, nil, material)
		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				add(
					name,
					Vector3.new(size.Z, d, d),
					cf * CFrame.new(a * ix / 2, b * iy / 2, 0) * CFrame.Angles(0, math.rad(90), 0),
					color,
					Enum.PartType.Cylinder,
					material
				)
			end
		end
	end

	return {
		pieces = pieces,
		s = s,
		add = add,
		roundedBox = roundedBox,
		roundedPlate = roundedPlate,
	}
end

local function buildBlockyBebeh(scale: number): Model
	local model = Instance.new("Model")
	local b = newBuilder(scale)
	local s, add = b.s, b.add

	local function at(x: number, y: number, z: number)
		return CFrame.new(s(x), s(y), s(z))
	end
	local function v(x: number, y: number, z: number)
		return Vector3.new(s(x), s(y), s(z))
	end

	local faceZ = -6.5 -- the front plane of the head

	-- Head -------------------------------------------------------------------
	b.roundedBox("Head", v(14, 13, 13), at(0, 0, 0), BROWN, s(2.6))

	-- Shading down his left side, and the yellow stripe from the reference.
	b.roundedPlate("SideShade", v(9, 11, 0.4), at(-7.05, 0, 0) * CFrame.Angles(0, math.rad(90), 0), BROWN_DARK, s(1.5))
	b.roundedPlate("Stripe", v(9.4, 3.2, 0.4), at(-7.15, 0.4, 0.6) * CFrame.Angles(0, math.rad(90), 0), EAR_YELLOW, s(1.4))

	-- Ears -------------------------------------------------------------------
	-- Two segments each so they taper and flop outward instead of standing stiff.
	for _, side in { -1, 1 } do
		local root = at(side * 3.4, 6.2, 0.4) * CFrame.Angles(math.rad(-10), 0, math.rad(side * 34))
		b.roundedPlate("Ear", v(3.4, 9, 1.1), root * CFrame.new(0, s(4.2), 0), EAR_YELLOW, s(1.5))
		-- The outer half bends a little further out, giving the floppy silhouette.
		local tip = root * CFrame.new(0, s(8.4), 0) * CFrame.Angles(0, 0, math.rad(side * 12))
		b.roundedPlate("EarTip", v(2.6, 7, 1.05), tip * CFrame.new(0, s(3.2), 0), EAR_YELLOW, s(1.2))
		b.roundedPlate("EarInner", v(1.5, 5.2, 0.3), root * CFrame.new(0, s(4.6), s(-0.5)), EAR_YELLOW_DARK, s(0.7))
	end

	-- Eyes -------------------------------------------------------------------
	-- Sleepy closed eyes, drawn as an arc of beads peaking in the middle.
	for _, side in { -1, 1 } do
		for i = 0, 6 do
			local t = (i / 6) * 2 - 1
			add(
				"Eye",
				v(0.9, 0.9, 0.5),
				at(side * 3.7 + t * 2.0, 2.5 - 1.35 * t * t, faceZ - 0.05),
				INK,
				Enum.PartType.Ball
			)
		end
	end

	-- Blush ------------------------------------------------------------------
	for _, side in { -1, 1 } do
		local cheek = add("Blush", v(3.8, 2.3, 0.9), at(side * 4.7, -0.4, faceZ), BLUSH, Enum.PartType.Ball)
		cheek.Transparency = 0.4
	end

	-- Bib --------------------------------------------------------------------
	b.roundedPlate("Bib", v(13, 4.6, 0.8), at(0, -4.3, faceZ - 0.25), BIB_BLUE, s(2))
	-- Shoulder straps sweeping up either side.
	for _, side in { -1, 1 } do
		b.roundedPlate(
			"BibStrap",
			v(3.4, 4.6, 0.8),
			at(side * 6.1, -2.2, faceZ - 0.25) * CFrame.Angles(0, 0, math.rad(side * -28)),
			BIB_BLUE,
			s(1.4)
		)
	end
	-- Bow.
	for _, side in { -1, 1 } do
		b.roundedPlate(
			"BowLoop",
			v(2.6, 1.9, 0.7),
			at(side * 1.9, -5.9, faceZ - 0.7) * CFrame.Angles(0, 0, math.rad(side * 20)),
			BIB_BLUE_LIGHT,
			s(0.85)
		)
	end
	add("BowKnot", v(1.3, 1.3, 1.3), at(0, -5.8, faceZ - 0.85), BIB_BLUE_LIGHT, Enum.PartType.Ball)

	-- Pacifier ---------------------------------------------------------------
	add("PaciShield", v(6, 4, 1.8), at(0, -2.3, faceZ - 0.8), BIB_BLUE, Enum.PartType.Ball)
	add("PaciKnob", v(3, 3, 2.6), at(0, -2.1, faceZ - 1.9), PACI_BLUE, Enum.PartType.Ball)
	-- The ring is a circle of beads, which reads as a torus from any angle.
	for i = 0, 11 do
		local angle = (i / 12) * math.pi * 2
		add(
			"PaciRing",
			v(1.05, 1.05, 1.05),
			at(0, -3.5, faceZ - 2.7) * CFrame.new(math.cos(angle) * s(1.9), math.sin(angle) * s(1.9), 0),
			PACI_PURPLE,
			Enum.PartType.Ball
		)
	end

	-- Body -------------------------------------------------------------------
	b.roundedBox("Diaper", v(13.2, 4, 13.2), at(0, -7.8, 0), DIAPER, s(1.8))
	for _, side in { -1, 1 } do
		add("Foot", v(4.4, 2.8, 5.8), at(side * 3.5, -10.2, -1.8), BROWN, Enum.PartType.Ball)
	end
	add("Tail", v(3, 3, 3), at(0, -8.4, 7.2), EAR_YELLOW, Enum.PartType.Ball)

	-- One invisible box does all the colliding, so players bump into a clean
	-- shape instead of catching on ears and pacifier beads.
	local collider = add("Collider", v(14.5, 22, 14), at(0, -4, 0), BROWN)
	collider.Transparency = 1
	collider.CanCollide = true
	collider.CanQuery = true
	model.PrimaryPart = collider

	for _, p in b.pieces do
		p.Parent = model
	end
	return model
end

-- A flat cutout of the user's own artwork, printed on both faces.
local function buildImageBebeh(scale: number, imageId: string): Model
	local model = Instance.new("Model")

	local height = 24 * scale
	local width = height * GameConfig.BebehImageAspect

	local board = Instance.new("Part")
	board.Name = "Bebeh"
	board.Size = Vector3.new(width, height, 0.6)
	board.CFrame = CFrame.new(0, 0, 0)
	board.Anchored = true
	board.CanCollide = true
	board.CanTouch = false
	board.Transparency = 1 -- decals still draw on an invisible part
	board.Parent = model
	model.PrimaryPart = board

	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local decal = Instance.new("Decal")
		decal.Texture = imageId
		decal.Face = face
		decal.Parent = board
	end

	return model
end

--[[
	Builds one Bebeh for an area.
	@param areaIndex  which area this Bebeh belongs to
	@param areaConfig the entry from GameConfig.Areas
	@param pivot      where to stand him, already facing the right way
]]
function BebehBuilder.build(areaIndex: number, areaConfig: any, pivot: CFrame): Model
	local scale = areaConfig.BebehScale

	local model: Model
	local template = ServerStorage:FindFirstChild("BigBebeh")
	if template and template:IsA("Model") then
		model = template:Clone()
		local ok, err = pcall(function()
			model:ScaleTo(scale)
		end)
		if not ok then
			warn(`[BigBebeh] Could not scale ServerStorage.BigBebeh: {err}`)
		end
	elseif GameConfig.BebehImageId ~= "" then
		model = buildImageBebeh(scale, GameConfig.BebehImageId)
	else
		model = buildBlockyBebeh(scale)
	end

	model.Name = areaConfig.BebehName
	model:PivotTo(pivot)

	-- Lift him so his feet rest on the platform instead of sinking into it.
	-- Measuring after the move keeps this correct for custom models too.
	local boxCFrame, size = model:GetBoundingBox()
	local bottom = boxCFrame.Position.Y - size.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, pivot.Position.Y - bottom, 0))
	model:SetAttribute("AreaIndex", areaIndex)

	-- Floating nameplate. The numbers are per-player, so the client fills them in.
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "BebehStatus"
	billboard.Size = UDim2.fromScale(14, 4.2)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, size.Y / 2 + 4 * scale, 0)
	billboard.MaxDistance = 220
	billboard.AlwaysOnTop = false

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.42)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.Text = areaConfig.BebehName
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextStrokeTransparency = 0
	title.TextScaled = true
	title.Parent = billboard

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.Position = UDim2.fromScale(0, 0.44)
	status.Size = UDim2.fromScale(1, 0.3)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.GothamBold
	status.Text = "Bring me cookies!"
	status.TextColor3 = Color3.fromRGB(255, 240, 170)
	status.TextStrokeTransparency = 0.2
	status.TextScaled = true
	status.Parent = billboard

	local barBack = Instance.new("Frame")
	barBack.Name = "BarBack"
	barBack.Position = UDim2.fromScale(0.1, 0.78)
	barBack.Size = UDim2.fromScale(0.8, 0.16)
	barBack.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	barBack.BorderSizePixel = 0
	barBack.Parent = billboard
	Instance.new("UICorner").Parent = barBack

	local barFill = Instance.new("Frame")
	barFill.Name = "BarFill"
	barFill.Size = UDim2.fromScale(0, 1)
	barFill.BackgroundColor3 = Color3.fromRGB(255, 196, 60)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack
	Instance.new("UICorner").Parent = barFill

	-- Custom models may not set a PrimaryPart, so fall back to any part.
	local anchorPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	billboard.Adornee = anchorPart
	billboard.Parent = anchorPart or model

	CollectionService:AddTag(model, "BigBebeh")
	return model
end

return BebehBuilder
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerStorage" referent="RBX13">
<Properties>
<string name="Name">ServerStorage</string>
</Properties>
</Item>
<Item class="StarterPlayer" referent="RBX15">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX14">
