<Item class="ModuleScript" referent="RBX4">
<Properties>
<string name="Name">GameConfig</string>
<ProtectedString name="Source"><![CDATA[
--[[
	GameConfig
	Every tunable number for the "Feed Big Bebeh" cookie game lives here.
	Tweak these values and the whole world rebuilds itself on the next run.
]]

local GameConfig = {}

-- Saving -------------------------------------------------------------------
GameConfig.SaveEnabled = true
GameConfig.DataStoreName = "BigBebehCookies_v2"
GameConfig.AutosaveInterval = 120

-- Big Bebeh's look ---------------------------------------------------------
-- Leave this empty to use the part-built Bebeh. To use your own artwork,
-- upload the picture to Roblox (Create → Decals), then paste its id here as
-- "rbxassetid://0000000000" and every Bebeh becomes a cutout of your image.
-- A Model named "BigBebeh" in ServerStorage beats both of these.
GameConfig.BebehImageId = ""
GameConfig.BebehImageAspect = 1152 / 1320 -- width / height of the artwork

-- Gameplay tuning ----------------------------------------------------------
GameConfig.FeedRadius = 16 -- studs; walk this close to Big Bebeh to auto-feed
GameConfig.FeedInterval = 0.3 -- seconds between auto-feed checks
GameConfig.CookieRespawnTime = 5 -- seconds before a picked-up cookie comes back
GameConfig.CollectRange = 14 -- server-side sanity check on pickups
GameConfig.VoidY = -60 -- fall below this and you get placed back on your area
GameConfig.MagnetInterval = 0.15 -- seconds between magnet sweeps

-- World layout -------------------------------------------------------------
-- Default platform footprint. An area can override it with its own
-- `PlatformSize`, which is how zone 1 stays a compact starter arena.
GameConfig.PlatformSize = Vector3.new(220, 6, 220)
GameConfig.AreaSpacing = 300 -- centre-to-centre distance along +X
GameConfig.BridgeWidth = 26

-- Areas --------------------------------------------------------------------
-- Feed the Bebeh in area N its HungerGoal to unlock area N + 1.
-- CarryCapacity is the base hand size once that area is unlocked; the
-- Bigger Hands upgrade multiplies it.
GameConfig.Areas = {
	{
		Name = "Cookie Nursery",
		PlatformSize = Vector3.new(190, 6, 190),
		-- Cookies spawn only inside this pit, so the rest of the map is walkable
		-- space for the board, the altar and the Bebeh.
		CookiePit = { Center = Vector3.new(0, 0, 18), Size = Vector3.new(76, 76) },
		-- Beside the pit, turned to face it. Standing it in front of the Bebeh
		-- blocked the view of him.
		BoardOffset = Vector3.new(-52, 0, 18),
		BoardYaw = -90,
		BebehOffset = Vector3.new(0, 0, -74),
		AltarOffset = Vector3.new(-62, 0, 62),
		ShopOffset = Vector3.new(62, 0, 62),
		FloorColor = Color3.fromRGB(126, 196, 122),
		AccentColor = Color3.fromRGB(255, 232, 120),
		CookieColor = Color3.fromRGB(214, 168, 106),
		CookieValue = 1,
		CookieCount = 26,
		CarryCapacity = 30,
		HungerGoal = 60,
		BebehName = "Baby Bebeh",
		BebehScale = 1,
	},
	{
		Name = "Sugar Sandbox",
		FloorColor = Color3.fromRGB(238, 205, 152),
		AccentColor = Color3.fromRGB(255, 170, 200),
		CookieColor = Color3.fromRGB(240, 214, 168),
		CookieValue = 4,
		CookieCount = 40,
		CarryCapacity = 120,
		HungerGoal = 400,
		BebehName = "Bigger Bebeh",
		BebehScale = 1.35,
	},
	{
		Name = "Frosting Fields",
		FloorColor = Color3.fromRGB(160, 214, 236),
		AccentColor = Color3.fromRGB(255, 255, 255),
		CookieColor = Color3.fromRGB(255, 236, 244),
		CookieValue = 15,
		CookieCount = 40,
		CarryCapacity = 450,
		HungerGoal = 1800,
		BebehName = "Chonky Bebeh",
		BebehScale = 1.75,
	},
	{
		Name = "Choco Chip Canyon",
		FloorColor = Color3.fromRGB(120, 84, 60),
		AccentColor = Color3.fromRGB(196, 132, 88),
		CookieColor = Color3.fromRGB(96, 62, 40),
		CookieValue = 60,
		CookieCount = 40,
		CarryCapacity = 1800,
		HungerGoal = 9000,
		BebehName = "Mega Bebeh",
		BebehScale = 2.2,
	},
	{
		Name = "Golden Crumb Summit",
		FloorColor = Color3.fromRGB(226, 186, 84),
		AccentColor = Color3.fromRGB(255, 246, 190),
		CookieColor = Color3.fromRGB(255, 214, 88),
		CookieValue = 250,
		CookieCount = 40,
		CarryCapacity = 7500,
		HungerGoal = 45000,
		BebehName = "BIG BEBEH",
		BebehScale = 2.8,
	},
}

-- Upgrades -----------------------------------------------------------------
-- Bought with Sprinkles, which you earn by feeding Big Bebeh.
GameConfig.SprinklesPerCookieFed = 1

GameConfig.BaseWalkSpeed = 16
GameConfig.CapacityPerLevel = 0.2 -- +20% of the area's base capacity per level
GameConfig.SpeedPerLevel = 2 -- +2 walk speed per level
GameConfig.MagnetBaseRadius = 9 -- radius at level 1
GameConfig.MagnetPerLevel = 2.5 -- extra radius for each level after the first
GameConfig.LuckPerLevel = 0.05 -- +5% chance of a double-value cookie per level
GameConfig.SpawnSpeedPerLevel = 0.06 -- -6% cookie respawn time per level
GameConfig.MinRespawnTime = 0.8 -- never faster than this, however many levels

GameConfig.Upgrades = {
	{
		Id = "Capacity",
		Name = "Bigger Hands",
		Icon = "🧤",
		Blurb = "Carry more cookies each trip",
		MaxLevel = 20,
		BaseCost = 40,
		CostMultiplier = 1.42,
	},
	{
		Id = "Speed",
		Name = "Sugar Rush",
		Icon = "👟",
		Blurb = "Run faster between cookies",
		MaxLevel = 15,
		BaseCost = 60,
		CostMultiplier = 1.5,
	},
	{
		Id = "Magnet",
		Name = "Cookie Magnet",
		Icon = "🧲",
		Blurb = "Suck up cookies without touching them",
		MaxLevel = 12,
		BaseCost = 120,
		CostMultiplier = 1.55,
	},
	{
		Id = "Spawn",
		Name = "Fresh Batch",
		Icon = "⏱️",
		Blurb = "Cookies respawn faster in the pit",
		MaxLevel = 12,
		BaseCost = 90,
		CostMultiplier = 1.5,
	},
	{
		Id = "Luck",
		Name = "Double Chip",
		Icon = "🍀",
		Blurb = "Chance for a cookie to count twice",
		MaxLevel = 10,
		BaseCost = 200,
		CostMultiplier = 1.6,
	},
}

-- Runes --------------------------------------------------------------------
-- Stand on the rune altar and it opens runes for you. Each open rolls down the
-- ladder from rarest to commonest, so adding a new tier is one entry here.
--
-- `Odds = 7` means a 1 in 7 roll. Keep the list sorted commonest-first.
--
-- The two boost numbers are read exactly as written: holding ONE gives
-- `FirstBoost`, and holding `MaxStack` of them gives `MaxBoost`. The curve
-- between is solved from those two points (see getRuneBoost), so you can state
-- a rune's power in the terms players actually see.
GameConfig.RuneOpenInterval = 1.1 -- seconds per open while standing on the altar
GameConfig.RuneAltarRadius = 15

GameConfig.RuneEffectNames = {
	CookieBoost = "Cookie Boost",
	RuneLuck = "Rune Luck",
	RuneBulk = "Rune Bulk",
	RuneClone = "Rune Clone",
}

-- Rune families. The menu shows one family at a time and lets you pick between
-- them, so a second family is one entry here plus runes tagged with its Id.
GameConfig.RuneTypes = {
	{
		Id = "Cookie",
		Name = "Cookie Rune",
		Icon = "🍪",
		Color = Color3.fromRGB(255, 190, 84),
		Blurb = "Opened at the Cookie Altar in the Nursery.",
	},
}

GameConfig.Runes = {
	{
		Id = "BasicCookie",
		Type = "Cookie",
		Name = "Basic Cookie",
		Odds = 1,
		Effect = "CookieBoost",
		FirstBoost = 0.1,
		MaxStack = 1000,
		MaxBoost = 1.0,
		Color = Color3.fromRGB(206, 206, 206),
	},
	{
		Id = "RareCookie",
		Type = "Cookie",
		Name = "Rare Cookie",
		Odds = 7,
		Effect = "CookieBoost",
		FirstBoost = 0.2,
		MaxStack = 2500,
		MaxBoost = 2.0,
		Color = Color3.fromRGB(88, 198, 255),
	},
}

function GameConfig.getRuneType(id: string)
	for _, runeType in GameConfig.RuneTypes do
		if runeType.Id == id then
			return runeType
		end
	end
	return nil
end

-- Every rune in a family, still in commonest-first order.
function GameConfig.getRunesOfType(typeId: string)
	local list = {}
	for _, rune in GameConfig.Runes do
		if rune.Type == typeId then
			table.insert(list, rune)
		end
	end
	return list
end

function GameConfig.getRune(id: string)
	for _, rune in GameConfig.Runes do
		if rune.Id == id then
			return rune
		end
	end
	return nil
end

--[[
	Boost from holding `count` of a rune.

	Solves `boost = MaxBoost * (n / MaxStack) ^ p` for the p that makes
	boost(1) = FirstBoost and boost(MaxStack) = MaxBoost, so both of the numbers
	quoted in the config are hit exactly and everything between curves smoothly.
]]
function GameConfig.getRuneBoost(rune: any, count: number): number
	if count <= 0 then
		return 0
	end
	local capped = math.min(count, rune.MaxStack)
	local p = math.log(rune.FirstBoost / rune.MaxBoost) / math.log(1 / rune.MaxStack)
	return rune.MaxBoost * (capped / rune.MaxStack) ^ p
end

function GameConfig.getRuneCount(state: any, id: string): number
	return (state.runes and state.runes[id]) or 0
end

-- Total of every rune contributing a given effect.
function GameConfig.getRuneEffectTotal(state: any, effect: string): number
	local total = 0
	for _, rune in GameConfig.Runes do
		if rune.Effect == effect then
			total += GameConfig.getRuneBoost(rune, GameConfig.getRuneCount(state, rune.Id))
		end
	end
	return total
end

function GameConfig.getCookieMultiplier(state: any): number
	return 1 + GameConfig.getRuneEffectTotal(state, "CookieBoost")
end

function GameConfig.getRuneLuck(state: any): number
	return 1 + GameConfig.getRuneEffectTotal(state, "RuneLuck")
end

function GameConfig.getRuneBulk(state: any): number
	return math.max(1, math.floor(1 + GameConfig.getRuneEffectTotal(state, "RuneBulk")))
end

function GameConfig.getRuneCloneChance(state: any): number
	return math.min(0.95, GameConfig.getRuneEffectTotal(state, "RuneClone"))
end

--[[
	Rolls one rune. Walks the ladder rarest-first; the first tier that hits wins,
	and the commonest tier is the floor so a roll always produces something.
	`luck` divides the odds, so x2 luck turns 1/7 into 1/3.5.
]]
function GameConfig.rollRune(luck: number)
	for i = #GameConfig.Runes, 2, -1 do
		local rune = GameConfig.Runes[i]
		if math.random() < math.min(1, luck / rune.Odds) then
			return rune
		end
	end
	return GameConfig.Runes[1]
end

-- Game passes --------------------------------------------------------------
--[[
	Paid perks. To make one live:

	  1. Create the pass on Roblox: Creations -> your experience -> Passes.
	  2. Open it and copy the number out of its URL.
	  3. Paste it into `AssetId` below.

	Until an AssetId is set the button still shows, but says it is not
	configured rather than prompting a purchase that would fail.

	Ownership is checked on the SERVER against Roblox and is never read from a
	save file, so a tampered save cannot grant a pass.
]]
GameConfig.GamePasses = {
	{
		Id = "DoubleCookies",
		Name = "x2 Cookies",
		Blurb = "Every cookie is worth double, forever",
		Icon = "🍪",
		AssetId = 0, -- <- paste your pass id here
		Multiplier = 2,
	},
}

function GameConfig.getGamePass(id: string)
	for _, pass in GameConfig.GamePasses do
		if pass.Id == id then
			return pass
		end
	end
	return nil
end

function GameConfig.ownsPass(state: any, id: string): boolean
	return (state.passes and state.passes[id]) == true
end

-- Cookie multiplier from every pass the player owns. Passes stack.
function GameConfig.getPassMultiplier(state: any): number
	local multiplier = 1
	for _, pass in GameConfig.GamePasses do
		if GameConfig.ownsPass(state, pass.Id) then
			multiplier *= pass.Multiplier
		end
	end
	return multiplier
end

-- Rebirth ------------------------------------------------------------------
-- Once BIG BEBEH is full you can start over. Areas reset, but you keep every
-- upgrade and sprinkle, plus a permanent multiplier on everything you collect.
GameConfig.RebirthMultiplierPerLevel = 0.5
GameConfig.RebirthSprinkleBonus = 2500

-- Helpers ------------------------------------------------------------------

--[[
	Where cookies are allowed to spawn in an area, as a centre and an XZ size.
	An area without a `CookiePit` falls back to most of its platform, which is
	what every zone past the first still does.
]]
function GameConfig.getCookiePit(areaIndex: number)
	local area = GameConfig.Areas[areaIndex]
	local center = GameConfig.getAreaCenter(areaIndex)
	if area.CookiePit then
		return center + area.CookiePit.Center, area.CookiePit.Size
	end
	local size = GameConfig.getPlatformSize(areaIndex)
	return center, Vector2.new(size.X - 40, size.Z - 40)
end

-- Fixed landmarks. Areas can place these themselves; otherwise they are
-- positioned relative to the platform's own size.
function GameConfig.getLandmark(areaIndex: number, key: string): Vector3
	local area = GameConfig.Areas[areaIndex]
	local center = GameConfig.getAreaCenter(areaIndex)
	if area[key] then
		return center + area[key]
	end
	local size = GameConfig.getPlatformSize(areaIndex)
	local defaults = {
		BebehOffset = Vector3.new(0, 0, -(size.Z / 2 - 25)),
		AltarOffset = Vector3.new(-(size.X / 2 - 26), 0, size.Z / 2 - 26),
		ShopOffset = Vector3.new(size.X / 2 - 26, 0, size.Z / 2 - 26),
		BoardOffset = Vector3.new(0, 0, -(size.Z / 2 - 6)),
	}
	return center + (defaults[key] or Vector3.new())
end

function GameConfig.getPlatformSize(areaIndex: number): Vector3
	return GameConfig.Areas[areaIndex].PlatformSize or GameConfig.PlatformSize
end

-- Where an area's platform ends along X. Bridges are built between these edges
-- rather than assuming every platform is the same width.
function GameConfig.getAreaEdge(areaIndex: number, side: number): number
	return GameConfig.getAreaCenter(areaIndex).X + side * GameConfig.getPlatformSize(areaIndex).X / 2
end

function GameConfig.getAreaCenter(areaIndex: number): Vector3
	return Vector3.new((areaIndex - 1) * GameConfig.AreaSpacing, 0, 0)
end

function GameConfig.getUpgrade(id: string)
	for _, upgrade in GameConfig.Upgrades do
		if upgrade.Id == id then
			return upgrade
		end
	end
	return nil
end

function GameConfig.getUpgradeLevel(state: any, id: string): number
	return (state.upgrades and state.upgrades[id]) or 0
end

-- Cost of the NEXT level, given how many you already own.
function GameConfig.getUpgradeCost(upgrade: any, currentLevel: number): number
	return math.floor(upgrade.BaseCost * upgrade.CostMultiplier ^ currentLevel)
end

function GameConfig.getCapacity(state: any): number
	local area = GameConfig.Areas[math.clamp(state.maxArea or 1, 1, #GameConfig.Areas)]
	local level = GameConfig.getUpgradeLevel(state, "Capacity")
	return math.floor(area.CarryCapacity * (1 + GameConfig.CapacityPerLevel * level))
end

function GameConfig.getWalkSpeed(state: any): number
	return GameConfig.BaseWalkSpeed + GameConfig.SpeedPerLevel * GameConfig.getUpgradeLevel(state, "Speed")
end

-- Level 0 means no magnet at all.
function GameConfig.getMagnetRadius(state: any): number
	local level = GameConfig.getUpgradeLevel(state, "Magnet")
	if level <= 0 then
		return 0
	end
	return GameConfig.MagnetBaseRadius + GameConfig.MagnetPerLevel * (level - 1)
end

-- How long a collected cookie stays gone. Driven by the upgrade of whoever
-- picked it up, since the cookies themselves are shared.
function GameConfig.getRespawnTime(state: any): number
	local level = GameConfig.getUpgradeLevel(state, "Spawn")
	local scaled = GameConfig.CookieRespawnTime * (1 - GameConfig.SpawnSpeedPerLevel * level)
	return math.max(GameConfig.MinRespawnTime, scaled)
end

function GameConfig.getLuckChance(state: any): number
	return math.min(1, GameConfig.LuckPerLevel * GameConfig.getUpgradeLevel(state, "Luck"))
end

function GameConfig.getRebirthMultiplier(state: any): number
	return 1 + GameConfig.RebirthMultiplierPerLevel * (state.rebirths or 0)
end

function GameConfig.canRebirth(state: any): boolean
	local last = #GameConfig.Areas
	return (state.fed and state.fed[last] or 0) >= GameConfig.Areas[last].HungerGoal
end

-- Short "what does this level do" text for the shop.
function GameConfig.describeUpgrade(state: any, upgrade: any): string
	local level = GameConfig.getUpgradeLevel(state, upgrade.Id)
	if upgrade.Id == "Capacity" then
		return `Hands: {GameConfig.abbreviate(GameConfig.getCapacity(state))}`
	elseif upgrade.Id == "Speed" then
		return `Speed: {GameConfig.getWalkSpeed(state)}`
	elseif upgrade.Id == "Magnet" then
		local radius = GameConfig.getMagnetRadius(state)
		return radius > 0 and `Reach: {math.floor(radius)} studs` or "Not bought yet"
	elseif upgrade.Id == "Spawn" then
		return `Respawn: {string.format("%.1f", GameConfig.getRespawnTime(state))}s`
	elseif upgrade.Id == "Luck" then
		return `Double chance: {math.floor(GameConfig.getLuckChance(state) * 100)}%`
	end
	return `Level {level}`
end

-- Turns 45000 into "45K" so the HUD never overflows.
function GameConfig.abbreviate(n: number): string
	local suffixes = { "", "K", "M", "B", "T" }
	local tier = 0
	local value = n
	while value >= 1000 and tier < #suffixes - 1 do
		value /= 1000
		tier += 1
	end
	if tier == 0 then
		return string.format("%d", value)
	end
	-- "45.0K" reads worse than "45K", so drop a trailing zero decimal.
	local text = string.gsub(string.format("%.1f", value), "%.0$", "")
	return text .. suffixes[tier + 1]
end

return GameConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5">
<Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[
--[[
	Remotes
	Creates the RemoteEvent folder on the server, waits for it on the client.
	require() this from either side and index the events by name.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "BigBebehRemotes"
local REMOTE_NAMES = {
	"SyncState", -- server -> client: the player's full progress table
	"Toast", -- server -> client: a short message for the notification stack
	"CookiePop", -- server -> client: "+N" floating text at a world position
	"FeedBurst", -- server -> client: make a Bebeh bounce and spit crumbs
	"BuyUpgrade", -- client -> server: "I want the next level of this upgrade"
	"Rebirth", -- client -> server: "start me over for the multiplier"
	"RuneDrop", -- server -> client: a rune just landed, show it
}

local folder: Folder

if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, name in REMOTE_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local Remotes = {}
for _, name in REMOTE_NAMES do
	Remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX3">
<Properties>
<string name="Name">UI</string>
</Properties>
<Item class="ModuleScript" referent="RBX1">
<Properties>
<string name="Name">Theme</string>
<ProtectedString name="Source"><![CDATA[
--[[
	Theme — the design tokens every piece of UI reads from.

	Nothing in the interface should hard-code a colour, a font size or a gap.
	They come from here, so the whole game restyles from one file and spacing
	stays consistent instead of drifting a few pixels per screen.

	Three rules this encodes:

	  * One dark ground, a handful of saturated accents. Accents mean something
	    (cookie / sprinkle / rune / good / bad); they are not decoration.
	  * A type scale, not arbitrary sizes. Six steps, each clearly different
	    from its neighbour, so hierarchy reads at a glance.
	  * A 4px spacing grid. Every gap and inset is a multiple of it, which is
	    most of why a layout looks deliberate rather than nudged into place.
]]

local Theme = {}

-- Palette ------------------------------------------------------------------
Theme.color = {
	-- Surfaces, darkest to lightest.
	bg = Color3.fromRGB(14, 13, 21),
	surface = Color3.fromRGB(26, 24, 38),
	surfaceAlt = Color3.fromRGB(38, 35, 54),
	surfaceHi = Color3.fromRGB(52, 48, 72),
	line = Color3.fromRGB(9, 8, 15),

	-- Text ramp.
	text = Color3.fromRGB(245, 243, 252),
	textDim = Color3.fromRGB(152, 147, 174),
	textFaint = Color3.fromRGB(104, 100, 124),

	-- Accents. Each one owns a concept.
	cookie = Color3.fromRGB(255, 199, 74),
	sprinkle = Color3.fromRGB(255, 122, 205),
	rune = Color3.fromRGB(167, 122, 255),
	hunger = Color3.fromRGB(255, 138, 180),

	-- States.
	good = Color3.fromRGB(64, 200, 112),
	warn = Color3.fromRGB(255, 168, 64),
	bad = Color3.fromRGB(226, 74, 92),
	muted = Color3.fromRGB(62, 58, 80),
}

-- Type ---------------------------------------------------------------------
Theme.font = {
	display = Enum.Font.FredokaOne, -- headings, numbers, buttons
	bold = Enum.Font.GothamBold, -- labels that need weight
	body = Enum.Font.GothamMedium, -- descriptions
}

Theme.textSize = {
	xs = 12,
	sm = 14,
	md = 17,
	lg = 22,
	xl = 28,
	xxl = 36,
}

-- Spacing: a 4px grid. `Theme.space(3)` is 12px.
function Theme.space(steps: number): number
	return steps * 4
end

Theme.radius = {
	sm = 8,
	md = 12,
	lg = 16,
}

Theme.stroke = {
	thin = 2,
	thick = 3,
}

-- Motion. Shared curves keep every transition feeling like one product.
Theme.motion = {
	fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	normal = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	-- Slight overshoot, for things that should feel springy (pickups, unlocks).
	pop = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
}

--[[
	How far a surface is lit from the top. UIGradient multiplies the fill, so 1
	leaves a colour untouched and lower values darken. Brightening past 1 is not
	possible -- ColorSequence rejects it -- so the top sits at 1 and the bottom
	carries the shading.
]]
Theme.sheen = {
	panel = 0.82,
	button = 0.76,
	row = 0.9,
}

return Theme
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2">
<Properties>
<string name="Name">Components</string>
<ProtectedString name="Source"><![CDATA[
--[[
	Components — the primitives every screen is built from.

	One definition per widget. A panel looks the same everywhere because there
	is exactly one function that makes panels, not thirty hand-set Frames that
	drifted apart.

	Every constructor takes (parent, props) and returns the instance. Props are
	applied last so a caller can override anything, and parenting happens inside
	so it can never be forgotten.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Components = {}

-- Internals ----------------------------------------------------------------

local function apply(instance: Instance, props: { [string]: any }?)
	if not props then
		return instance
	end
	for key, value in props do
		(instance :: any)[key] = value
	end
	return instance
end

local function round(instance: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = instance
	return c
end

local function outline(instance: Instance, thickness: number, color: Color3?)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = color or Theme.color.line
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = instance
	return s
end

--[[
	Top-down sheen. Values are clamped because ColorSequence rejects anything
	outside 0-1 and one out-of-range value takes down the whole script.
]]
local function sheen(instance: Instance, bottom: number)
	local function grey(v: number)
		local c = math.clamp(v, 0, 1)
		return Color3.new(c, c, c)
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, grey(1)),
		ColorSequenceKeypoint.new(1, grey(bottom)),
	})
	g.Rotation = 90
	g.Parent = instance
	return g
end

Components.round = round
Components.outline = outline
Components.sheen = sheen

-- Layout helpers -----------------------------------------------------------

function Components.padding(parent: Instance, steps: number)
	local pad = Instance.new("UIPadding")
	local amount = UDim.new(0, Theme.space(steps))
	pad.PaddingTop = amount
	pad.PaddingBottom = amount
	pad.PaddingLeft = amount
	pad.PaddingRight = amount
	pad.Parent = parent
	return pad
end

function Components.list(parent: Instance, gapSteps: number, horizontal: boolean?)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, Theme.space(gapSteps))
	layout.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

-- Widgets ------------------------------------------------------------------

function Components.label(parent: Instance, props: { [string]: any }?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Theme.font.bold
	label.TextColor3 = Theme.color.text
	label.TextSize = Theme.textSize.md
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.RichText = true
	apply(label, props)
	label.Parent = parent
	return label
end

function Components.panel(parent: Instance, props: { [string]: any }?): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Theme.color.surface
	frame.BorderSizePixel = 0
	apply(frame, props)
	frame.Parent = parent
	round(frame, Theme.radius.lg)
	outline(frame, Theme.stroke.thick)
	sheen(frame, Theme.sheen.panel)
	return frame
end

-- A compact stat readout: coloured icon, then a value. Used for currencies.
function Components.pill(parent: Instance, config: {
	icon: string,
	color: Color3,
	text: string?,
	props: { [string]: any }?,
}): (Frame, TextLabel)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Theme.color.surface
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(0, 196, 0, 44)
	apply(frame, config.props)
	frame.Parent = parent
	round(frame, Theme.radius.md)
	outline(frame, Theme.stroke.thick)
	sheen(frame, Theme.sheen.panel)

	-- A colour chip carries the identity, so the value can stay plain white and
	-- readable rather than tinted to the point of poor contrast.
	local chip = Instance.new("Frame")
	chip.Size = UDim2.new(0, 30, 0, 30)
	chip.Position = UDim2.new(0, Theme.space(2), 0.5, -15)
	chip.BackgroundColor3 = config.color
	chip.BorderSizePixel = 0
	chip.Parent = frame
	round(chip, Theme.radius.sm)
	sheen(chip, 0.8)

	Components.label(chip, {
		Size = UDim2.fromScale(1, 1),
		Font = Theme.font.display,
		Text = config.icon,
		TextSize = Theme.textSize.md,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	local value = Components.label(frame, {
		Name = "Value",
		Position = UDim2.new(0, Theme.space(11), 0, 0),
		Size = UDim2.new(1, -Theme.space(13), 1, 0),
		Font = Theme.font.display,
		Text = config.text or "0",
		TextSize = Theme.textSize.lg,
		TextStrokeTransparency = 0.4,
	})

	return frame, value
end

--[[
	A progress bar. Returns a setter rather than the fill frame, so callers deal
	in a 0-1 ratio and cannot forget to clamp it.
]]
function Components.bar(parent: Instance, config: {
	color: Color3,
	height: number?,
	props: { [string]: any }?,
}): (Frame, (number, Color3?) -> ())
	local track = Instance.new("Frame")
	track.BackgroundColor3 = Theme.color.bg
	track.BorderSizePixel = 0
	track.Size = UDim2.new(1, 0, 0, config.height or 12)
	apply(track, config.props)
	track.Parent = parent
	round(track, Theme.radius.sm)
	outline(track, Theme.stroke.thin, Theme.color.surfaceHi)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = config.color
	fill.BorderSizePixel = 0
	fill.Parent = track
	round(fill, Theme.radius.sm)
	sheen(fill, 0.78)

	local function set(ratio: number, color: Color3?)
		local clamped = math.clamp(ratio, 0, 1)
		TweenService:Create(fill, Theme.motion.normal, { Size = UDim2.fromScale(clamped, 1) }):Play()
		if color then
			fill.BackgroundColor3 = color
		end
	end

	return track, set
end

function Components.button(parent: Instance, config: {
	text: string,
	color: Color3?,
	props: { [string]: any }?,
	onClick: (() -> ())?,
}): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = config.color or Theme.color.good
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Theme.font.display
	button.TextColor3 = Theme.color.text
	button.TextSize = Theme.textSize.lg
	button.Text = config.text
	button.Size = UDim2.new(0, 140, 0, 48)
	apply(button, config.props)
	button.Parent = parent
	round(button, Theme.radius.md)
	outline(button, Theme.stroke.thick)
	sheen(button, Theme.sheen.button)

	--[[
		A press should feel like a press. The rest size is captured once: reading
		button.Size at click time would measure a half-finished tween and the
		button would creep smaller with every press.
	]]
	local restSize = button.Size
	local pressedSize = restSize - UDim2.fromOffset(0, 3)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, Theme.motion.fast, { Size = pressedSize }):Play()
	end)
	local function release()
		TweenService:Create(button, Theme.motion.fast, { Size = restSize }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)

	if config.onClick then
		button.Activated:Connect(config.onClick)
	end
	return button
end

--[[
	A coloured icon square. Carries the identity of a row or stat so the text
	beside it can stay plain white and readable rather than tinted until it
	fails contrast.
]]
function Components.chip(parent: Instance, config: {
	icon: string,
	color: Color3,
	size: number?,
	props: { [string]: any }?,
}): Frame
	local side = config.size or 38
	local chip = Instance.new("Frame")
	chip.BackgroundColor3 = config.color
	chip.BorderSizePixel = 0
	chip.Size = UDim2.fromOffset(side, side)
	apply(chip, config.props)
	chip.Parent = parent
	round(chip, Theme.radius.sm)
	sheen(chip, 0.8)

	Components.label(chip, {
		Size = UDim2.fromScale(1, 1),
		Font = Theme.font.display,
		Text = config.icon,
		TextSize = math.floor(side * 0.52),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	return chip
end

-- A list row: the surface an entry in a scrolling list sits on.
function Components.row(parent: Instance, props: { [string]: any }?): Frame
	local row = Instance.new("Frame")
	row.BackgroundColor3 = Theme.color.surfaceAlt
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, -6, 0, 84)
	apply(row, props)
	row.Parent = parent
	round(row, Theme.radius.md)
	outline(row, Theme.stroke.thin)
	sheen(row, Theme.sheen.row)
	return row
end

--[[
	A centred modal: panel, header strip with a title and close button, and a
	body to fill. Returns all three so a caller can drop extras into the header
	without every screen re-inventing its own chrome.
]]
function Components.modal(parent: Instance, config: {
	title: string,
	accent: Color3?,
	size: UDim2?,
	onClose: (() -> ())?,
	props: { [string]: any }?,
}): (Frame, Frame, Frame)
	local panel = Components.panel(parent, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = config.size or UDim2.fromOffset(520, 560),
		Visible = false,
	})
	apply(panel, config.props)
	Components.padding(panel, 4)

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 48)
	header.Parent = panel

	Components.label(header, {
		Name = "Title",
		Size = UDim2.new(1, -180, 1, 0),
		Font = Theme.font.display,
		Text = config.title,
		TextColor3 = config.accent or Theme.color.text,
		TextSize = Theme.textSize.xl,
		TextStrokeTransparency = 0.5,
	})

	Components.button(header, {
		text = "✕",
		color = Theme.color.bad,
		props = {
			Name = "Close",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(46, 46),
		},
		onClick = function()
			panel.Visible = false
			if config.onClose then
				config.onClose()
			end
		end,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, 0, 0, Theme.space(14))
	body.Size = UDim2.new(1, 0, 1, -Theme.space(14))
	body.Parent = panel

	return panel, body, header
end

-- A scrolling column, sized to its contents.
function Components.scroller(parent: Instance, gapSteps: number, props: { [string]: any }?): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 4
	scroller.ScrollBarImageColor3 = Theme.color.surfaceHi
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.CanvasSize = UDim2.new()
	scroller.Size = UDim2.fromScale(1, 1)
	apply(scroller, props)
	scroller.Parent = parent
	Components.list(scroller, gapSteps)
	return scroller
end

return Components
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX17">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX12">
<Properties>
<string name="Name">BigBebehGame</string>
<ProtectedString name="Source"><![CDATA[
--[[
	Big Bebeh — Cookie Collector (server)

	The loop:
	  1. Cookies lie around each area. Walk over one to pick it up.
	  2. Your hands only hold so many; when they are full, go feed Big Bebeh.
	  3. Stand on his pad and he eats everything you are carrying, paying out
	     Sprinkles as he goes.
	  4. Fill his hunger bar and the gate to the next area opens for you.
	  5. Spend Sprinkles at the shop on hands, speed, magnet and luck.
	  6. Once BIG BEBEH is full, rebirth for a permanent multiplier.

	All tuning lives in ReplicatedStorage/BigBebehShared/GameConfig.
]]

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)
local Remotes = require(ReplicatedStorage.BigBebehShared.Remotes)
local AntiCheat = require(script.AntiCheat)
local BebehBuilder = require(script.BebehBuilder)
local PlayerState = require(script.PlayerState)
local WorldBuilder = require(script.WorldBuilder)

local COOKIE_COLOR = Color3.fromRGB(255, 226, 140)
local LUCKY_COLOR = Color3.fromRGB(150, 255, 170)
local UNLOCK_COLOR = Color3.fromRGB(140, 255, 170)
local SPRINKLE_COLOR = Color3.fromRGB(255, 150, 220)
local DENY_COLOR = Color3.fromRGB(255, 150, 130)

local world = WorldBuilder.build()

local cookiePool = Instance.new("Folder")
cookiePool.Name = "CookiePool"
cookiePool.Parent = ServerStorage

-- Cookies grouped by area, so the magnet only ever scans one platform's worth.
local cookiesByArea: { [number]: { Model } } = {}

-- Cookie spawning ----------------------------------------------------------

-- Somewhere on the platform that is not on top of the Bebeh or his feed pad.
local function randomCookiePosition(areaIndex: number): Vector3
	-- Cookies belong in the pit and nowhere else, which is what keeps the rest of
	-- the map walkable instead of carpeted.
	local pitCenter, pitSize = GameConfig.getCookiePit(areaIndex)
	local halfX = math.max(6, pitSize.X / 2 - 6)
	local halfZ = math.max(6, pitSize.Y / 2 - 6)
	-- The pit floor sits 2.5 studs below the platform, so cookies ride just above it.
	local y = pitCenter.Y + 0.3

	return Vector3.new(
		pitCenter.X + math.random(-halfX, halfX),
		y,
		pitCenter.Z + math.random(-halfZ, halfZ)
	)
end

-- Import models/BigBebehCookie.fbx and name it "CookieModel" in ServerStorage
-- to swap the procedural cookie for the sculpted mesh.
local COOKIE_TEMPLATE = ServerStorage:FindFirstChild("CookieModel")
local COOKIE_TARGET_WIDTH = 3.2

local function createMeshCookie(areaIndex: number): Model
	local cfg = GameConfig.Areas[areaIndex]
	local model = (COOKIE_TEMPLATE :: Model):Clone()
	model.Name = "Cookie"

	-- Match the procedural cookie's footprint whatever scale it imported at.
	pcall(function()
		model:ScaleTo(1)
		local _, size = model:GetBoundingBox()
		if size.X > 0.001 then
			model:ScaleTo(COOKIE_TARGET_WIDTH / size.X)
		end
	end)

	-- The biggest part becomes the touch target; the chips stay inert.
	local biggest: BasePart? = nil
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Material = Enum.Material.Sand
			local color = BebehBuilder.colorFor(part.Name)
			part.Color = color or cfg.CookieColor
			if not biggest or part.Size.Magnitude > biggest.Size.Magnitude then
				biggest = part
			end
		end
	end

	if biggest then
		biggest.Name = "Disc"
		biggest.CanTouch = true
		model.PrimaryPart = biggest
	end

	model:SetAttribute("AreaIndex", areaIndex)
	model:SetAttribute("Value", cfg.CookieValue)
	model:SetAttribute("IsMesh", true)
	return model
end

local function createCookie(areaIndex: number): Model
	if COOKIE_TEMPLATE and COOKIE_TEMPLATE:IsA("Model") then
		return createMeshCookie(areaIndex)
	end

	local cfg = GameConfig.Areas[areaIndex]

	local model = Instance.new("Model")
	model.Name = "Cookie"

	local disc = Instance.new("Part")
	disc.Name = "Disc"
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.6, 3.2, 3.2)
	disc.Color = cfg.CookieColor
	disc.Material = Enum.Material.Sand
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanTouch = true
	disc.Parent = model
	model.PrimaryPart = disc

	-- Chocolate chips scattered on the top face.
	for i = 1, 4 do
		local angle = (i / 4) * math.pi * 2 + math.random() * 0.6
		local chip = Instance.new("Part")
		chip.Name = "Chip"
		chip.Shape = Enum.PartType.Ball
		chip.Size = Vector3.new(0.7, 0.7, 0.7)
		chip.Color = cfg.CookieColor:Lerp(Color3.fromRGB(40, 24, 14), 0.75)
		chip.Material = Enum.Material.SmoothPlastic
		chip.Anchored = true
		chip.CanCollide = false
		chip.CanTouch = false
		chip.CanQuery = false
		chip.Parent = model
		chip:SetAttribute("Offset", Vector3.new(math.cos(angle) * 0.9, 0.35, math.sin(angle) * 0.9))
	end

	model:SetAttribute("AreaIndex", areaIndex)
	model:SetAttribute("Value", cfg.CookieValue)

	return model
end

-- Places a cookie model at a fresh random spot in its area.
local function placeCookie(model: Model)
	local areaIndex = model:GetAttribute("AreaIndex") :: number
	local pos = randomCookiePosition(areaIndex)

	if model:GetAttribute("IsMesh") then
		-- The sculpted cookie is already flat, so move it whole and spin the
		-- yaw for variety.
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	else
		local disc = model.PrimaryPart :: Part
		-- The cylinder's axis runs along its local X, so roll it 90° to lie flat.
		disc.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
		for _, chip in model:GetChildren() do
			if chip:IsA("BasePart") and chip.Name == "Chip" then
				chip.Position = pos + (chip:GetAttribute("Offset") :: Vector3)
			end
		end
	end

	model.Parent = world.cookiesFolder
end

-- Player helpers -----------------------------------------------------------

local lastToast: { [Player]: number } = {}

local function toast(player: Player, message: string, color: Color3?, throttleSeconds: number?)
	if throttleSeconds then
		local now = os.clock()
		if lastToast[player] and now - lastToast[player] < throttleSeconds then
			return
		end
		lastToast[player] = now
	end
	Remotes.Toast:FireClient(player, message, color or Color3.fromRGB(255, 255, 255))
end

local function applyWalkSpeed(player: Player, state: any)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = GameConfig.getWalkSpeed(state)
	end
end

local function sync(player: Player)
	local state = PlayerState.get(player)
	if not state then
		return
	end

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Cookies.Value = state.carried
		stats.Sprinkles.Value = state.sprinkles
		stats.Area.Value = state.maxArea
		stats.Rebirths.Value = state.rebirths
	end

	Remotes.SyncState:FireClient(player, {
		maxArea = state.maxArea,
		carried = state.carried,
		capacity = GameConfig.getCapacity(state),
		fed = state.fed,
		totalFed = state.totalFed,
		sprinkles = state.sprinkles,
		upgrades = state.upgrades,
		rebirths = state.rebirths,
		runes = state.runes,
		runesOpened = state.runesOpened,
		passes = state.passes,
	})
end

local function areaAtPosition(position: Vector3): number
	local index = math.round(position.X / GameConfig.AreaSpacing) + 1
	return math.clamp(index, 1, #GameConfig.Areas)
end

local function teleportToArea(player: Player, areaIndex: number)
	local character = player.Character
	if not character then
		return
	end
	local center = GameConfig.getAreaCenter(areaIndex)
	-- Tell the watchdog before moving them, or the game's own teleport reads as a
	-- teleport exploit the instant it lands.
	AntiCheat.pardon(player, 3)
	character:PivotTo(CFrame.new(center + Vector3.new(0, 6, 70)))
end

-- Collecting ---------------------------------------------------------------

-- `allowedRange` lets the magnet reach further than a plain footstep pickup.
local function collect(player: Player, model: Model, allowedRange: number?)
	local state = PlayerState.get(player)
	if not state then
		return
	end

	local areaIndex = model:GetAttribute("AreaIndex") :: number
	if state.maxArea < areaIndex then
		toast(player, `Feed {GameConfig.Areas[areaIndex - 1].BebehName} first!`, nil, 3)
		return
	end

	local capacity = GameConfig.getCapacity(state)
	if state.carried >= capacity then
		toast(player, "Hands full! Go feed Big Bebeh 🍪", Color3.fromRGB(255, 180, 120), 3)
		return
	end

	-- Distance check so a mis-fired Touched can't grab a cookie across the map.
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not model.PrimaryPart then
		return
	end
	if (root.Position - model.PrimaryPart.Position).Magnitude > (allowedRange or GameConfig.CollectRange) then
		return
	end

	local value = (model:GetAttribute("Value") :: number)
		* GameConfig.getRebirthMultiplier(state)
		* GameConfig.getCookieMultiplier(state)
		* GameConfig.getPassMultiplier(state)
	local lucky = math.random() < GameConfig.getLuckChance(state)
	if lucky then
		value *= 2
	end

	local gained = math.min(math.floor(value), capacity - state.carried)
	state.carried += gained

	Remotes.CookiePop:FireClient(
		player,
		model.PrimaryPart.Position,
		lucky and `+{GameConfig.abbreviate(gained)} x2!` or `+{GameConfig.abbreviate(gained)}`,
		lucky and LUCKY_COLOR or COOKIE_COLOR
	)
	sync(player)

	-- Hide it, then bring it back somewhere else on the same platform.
	model.Parent = cookiePool
	-- Whoever picked it up decides how fast it comes back; the cookies are shared.
	task.delay(GameConfig.getRespawnTime(state), function()
		if model.Parent == cookiePool then
			placeCookie(model)
		end
	end)
end

local function armCookie(model: Model)
	local disc = model.PrimaryPart :: Part
	disc.Touched:Connect(function(hit)
		-- Ignore touches while the cookie is pooled or already being claimed.
		if model.Parent ~= world.cookiesFolder then
			return
		end
		local character = hit.Parent
		if not character or not character:FindFirstChildOfClass("Humanoid") then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			collect(player, model)
		end
	end)
end

for areaIndex = 1, #GameConfig.Areas do
	cookiesByArea[areaIndex] = {}
	for _ = 1, GameConfig.Areas[areaIndex].CookieCount do
		local cookie = createCookie(areaIndex)
		placeCookie(cookie)
		armCookie(cookie)
		table.insert(cookiesByArea[areaIndex], cookie)
	end
end

-- Magnet -------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(GameConfig.MagnetInterval)
		for player, state in PlayerState.all() do
			local radius = GameConfig.getMagnetRadius(state)
			if radius <= 0 then
				continue
			end

			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root or state.carried >= GameConfig.getCapacity(state) then
				continue
			end

			local areaIndex = areaAtPosition(root.Position)
			if areaIndex > state.maxArea then
				continue
			end

			for _, cookie in cookiesByArea[areaIndex] do
				if cookie.Parent ~= world.cookiesFolder or not cookie.PrimaryPart then
					continue
				end
				if (cookie.PrimaryPart.Position - root.Position).Magnitude <= radius then
					collect(player, cookie, radius + 6)
					if state.carried >= GameConfig.getCapacity(state) then
						break
					end
				end
			end
		end
	end
end)

-- Feeding ------------------------------------------------------------------

local bebehs: { [number]: Model } = {}
for _, model in CollectionService:GetTagged("BigBebeh") do
	bebehs[model:GetAttribute("AreaIndex") :: number] = model
end

local function feed(player: Player, areaIndex: number)
	local state = PlayerState.get(player)
	if not state or state.carried <= 0 then
		return
	end

	local cfg = GameConfig.Areas[areaIndex]
	local remaining = cfg.HungerGoal - state.fed[areaIndex]
	if remaining <= 0 then
		return
	end

	local amount = math.min(state.carried, remaining)
	state.carried -= amount
	state.fed[areaIndex] += amount
	state.totalFed += amount

	local earned = math.floor(amount * GameConfig.SprinklesPerCookieFed * GameConfig.getRebirthMultiplier(state))
	state.sprinkles += earned

	local bebeh = bebehs[areaIndex]
	if bebeh then
		Remotes.FeedBurst:FireClient(player, bebeh, amount)
		if earned > 0 then
			Remotes.CookiePop:FireClient(
				player,
				bebeh:GetPivot().Position,
				`+{GameConfig.abbreviate(earned)} ✨`,
				SPRINKLE_COLOR
			)
		end
	end

	if state.fed[areaIndex] >= cfg.HungerGoal then
		if areaIndex < #GameConfig.Areas and state.maxArea == areaIndex then
			state.maxArea = areaIndex + 1
			local nextCfg = GameConfig.Areas[state.maxArea]
			toast(player, `🎉 {nextCfg.Name} unlocked!`, UNLOCK_COLOR)
		elseif areaIndex == #GameConfig.Areas then
			toast(player, "🏆 BIG BEBEH IS FULL — rebirth is ready!", UNLOCK_COLOR)
		end
	end

	sync(player)
end

task.spawn(function()
	while true do
		task.wait(GameConfig.FeedInterval)
		for player, state in PlayerState.all() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end

			if root.Position.Y < GameConfig.VoidY then
				teleportToArea(player, math.min(state.maxArea, areaAtPosition(root.Position)))
				continue
			end

			if state.carried <= 0 then
				continue
			end

			for areaIndex = 1, state.maxArea do
				local bebeh = bebehs[areaIndex]
				if not bebeh or state.fed[areaIndex] >= GameConfig.Areas[areaIndex].HungerGoal then
					continue
				end
				-- Flat distance: his pivot sits well above the player's head.
				local offset = bebeh:GetPivot().Position - root.Position
				if Vector2.new(offset.X, offset.Z).Magnitude <= GameConfig.FeedRadius + 8 then
					feed(player, areaIndex)
					break
				end
			end
		end
	end
end)

-- Runes --------------------------------------------------------------------

local runeAltars: { BasePart } = {}
for _, crystal in CollectionService:GetTagged("RuneCrystal") do
	if crystal:IsA("BasePart") then
		table.insert(runeAltars, crystal)
	end
end

local function openRunes(player: Player, state: any)
	local bulk = GameConfig.getRuneBulk(state)
	local luck = GameConfig.getRuneLuck(state)
	local cloneChance = GameConfig.getRuneCloneChance(state)

	local drops: { { id: string, amount: number } } = {}
	for _ = 1, bulk do
		local rune = GameConfig.rollRune(luck)
		-- Rune Clone occasionally doubles a single roll.
		local amount = (math.random() < cloneChance) and 2 or 1
		state.runes[rune.Id] = (state.runes[rune.Id] or 0) + amount
		state.runesOpened += amount
		table.insert(drops, { id = rune.Id, amount = amount })
	end

	Remotes.RuneDrop:FireClient(player, drops)
	sync(player)
end

task.spawn(function()
	while true do
		task.wait(GameConfig.RuneOpenInterval)
		if #runeAltars == 0 then
			continue
		end
		for player, state in PlayerState.all() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end
			for _, altar in runeAltars do
				local offset = altar.Position - root.Position
				if Vector2.new(offset.X, offset.Z).Magnitude <= GameConfig.RuneAltarRadius then
					openRunes(player, state)
					break
				end
			end
		end
	end
end)

-- Shop and rebirth ---------------------------------------------------------

Remotes.BuyUpgrade.OnServerEvent:Connect(function(player, upgradeId)
	if not AntiCheat.allow(player, "BuyUpgrade") then
		return
	end
	if type(upgradeId) ~= "string" then
		-- The real client only ever sends a string. Anything else was hand-built.
		AntiCheat.flag(player, "BadPayload", `BuyUpgrade sent a {typeof(upgradeId)}`)
		return
	end
	local state = PlayerState.get(player)
	local upgrade = GameConfig.getUpgrade(upgradeId)
	if not state or not upgrade then
		return
	end

	local level = GameConfig.getUpgradeLevel(state, upgradeId)
	if level >= upgrade.MaxLevel then
		toast(player, `{upgrade.Name} is already maxed out!`, DENY_COLOR, 1)
		return
	end

	local cost = GameConfig.getUpgradeCost(upgrade, level)
	if state.sprinkles < cost then
		toast(player, `Need {GameConfig.abbreviate(cost - state.sprinkles)} more sprinkles`, DENY_COLOR, 1)
		return
	end

	state.sprinkles -= cost
	state.upgrades[upgradeId] = level + 1
	applyWalkSpeed(player, state)
	toast(player, `{upgrade.Icon} {upgrade.Name} → level {level + 1}`, SPRINKLE_COLOR)
	sync(player)
end)

Remotes.Rebirth.OnServerEvent:Connect(function(player)
	if not AntiCheat.allow(player, "Rebirth") then
		return
	end
	local state = PlayerState.get(player)
	if not state then
		return
	end
	if not GameConfig.canRebirth(state) then
		toast(player, "Fill BIG BEBEH first to rebirth!", DENY_COLOR, 1)
		return
	end

	state.rebirths += 1
	state.maxArea = 1
	state.carried = 0
	for i = 1, #GameConfig.Areas do
		state.fed[i] = 0
	end
	state.sprinkles += GameConfig.RebirthSprinkleBonus
	-- Runes and upgrades survive a rebirth; only the areas reset.

	teleportToArea(player, 1)
	applyWalkSpeed(player, state)
	toast(
		player,
		`⭐ Rebirth {state.rebirths}! Everything you collect is now x{GameConfig.getRebirthMultiplier(state)}`,
		UNLOCK_COLOR
	)
	sync(player)
end)

-- Game passes --------------------------------------------------------------

--[[
	Ownership is answered by Roblox, on the server, once per session. It is never
	read from the save and never taken from the client, so neither an edited save
	nor a spoofed remote can hand somebody a paid perk.
]]
local function refreshPasses(player: Player, state: any)
	for _, pass in GameConfig.GamePasses do
		if pass.AssetId <= 0 then
			continue -- not configured yet; the button explains this to the player
		end
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.AssetId)
		end)
		if ok then
			state.passes[pass.Id] = owns
		else
			-- A failed check must not silently grant the perk.
			state.passes[pass.Id] = false
			warn(`[BigBebeh] Could not check {pass.Name} for {player.Name}: {owns}`)
		end
	end
end

-- Grant immediately on purchase, so nobody has to rejoin to see it work.
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, assetId, purchased)
	if not purchased then
		return
	end
	local state = PlayerState.get(player)
	if not state then
		return
	end
	for _, pass in GameConfig.GamePasses do
		if pass.AssetId > 0 and pass.AssetId == assetId then
			state.passes[pass.Id] = true
			toast(player, `{pass.Icon} {pass.Name} active!`, UNLOCK_COLOR)
			sync(player)
		end
	end
end)

-- Players ------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	AntiCheat.watch(player)

	if AntiCheat.isBanned(player.UserId) then
		player:Kick("You are banned from this experience.")
		return
	end

	local state, refused = PlayerState.load(player)
	if not state then
		-- Their save is open in another server. Letting them play from stale data
		-- is how currency gets duplicated, so they wait instead.
		player:Kick(refused)
		return
	end

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Cookies", "Sprinkles", "Area", "Rebirths" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		applyWalkSpeed(player, state)
		sync(player)
	end)

	applyWalkSpeed(player, state)
	sync(player)
	toast(player, `Welcome! Collect cookies and feed {GameConfig.Areas[state.maxArea].BebehName}.`, COOKIE_COLOR)

	-- Asking Roblox who owns what is a web call. Run it after the first sync so a
	-- slow answer delays the pass button lighting up, not the entire HUD.
	task.spawn(function()
		refreshPasses(player, state)
		if PlayerState.get(player) == state then
			sync(player)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	lastToast[player] = nil
	AntiCheat.forget(player)
	PlayerState.release(player)
end)

-- Movement sampling and Discord reporting. AntiCheat cannot require PlayerState
-- itself without a require cycle, so it is handed a way to read state instead.
AntiCheat.start(function(player)
	return PlayerState.get(player)
end)

-- The client pings this once its UI is built, so it never misses the first sync.
Remotes.SyncState.OnServerEvent:Connect(function(player)
	-- Cheap to serve but not free, and it is the easiest remote to sit in a loop.
	if not AntiCheat.allow(player, "SyncState") then
		return
	end
	sync(player)
end)

task.spawn(function()
	while true do
		task.wait(GameConfig.AutosaveInterval)
		for player in PlayerState.all() do
			PlayerState.save(player)
		end
	end
end)

game:BindToClose(function()
	for player in PlayerState.all() do
		PlayerState.save(player)
	end
end)
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX7">
<Properties>
<string name="Name">PlayerState</string>
<ProtectedString name="Source"><![CDATA[
--[[
	PlayerState
	Per-player progress, with optional DataStore persistence.

	state = {
		maxArea   = 1,          -- highest area unlocked
		carried   = 0,          -- cookies currently in hand
		fed       = { 12, 0 },  -- cookies fed to each area's Bebeh
		totalFed  = 12,
		sprinkles = 340,        -- upgrade currency, earned by feeding
		upgrades  = { Capacity = 3, Speed = 1 },
		rebirths  = 0,
		runes     = { BasicCookie = 412, RareCookie = 8 },
		runesOpened = 420,
		passes    = { DoubleCookies = true }, -- runtime only, never saved
	}
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)
local SessionLock = require(script.Parent.SessionLock)

local PlayerState = {}

local states: { [Player]: any } = {}

local store: DataStore? = nil
if GameConfig.SaveEnabled then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
		SessionLock.startHeartbeat(result)
	else
		warn(`[BigBebeh] DataStore unavailable, running without saves: {result}`)
	end
end

local function defaultState()
	local upgrades = {}
	for _, upgrade in GameConfig.Upgrades do
		upgrades[upgrade.Id] = 0
	end
	local runes = {}
	for _, rune in GameConfig.Runes do
		runes[rune.Id] = 0
	end
	return {
		maxArea = 1,
		carried = 0,
		fed = table.create(#GameConfig.Areas, 0),
		totalFed = 0,
		sprinkles = 0,
		upgrades = upgrades,
		rebirths = 0,
		runes = runes,
		runesOpened = 0,
		-- Game pass ownership is filled in from Roblox after the state loads.
		passes = {},
	}
end

-- Anything loaded from a DataStore is untrusted: an older save may be missing
-- fields, or have more/fewer areas than the current config.
local function sanitize(raw: any)
	local state = defaultState()
	if type(raw) ~= "table" then
		return state
	end

	if type(raw.maxArea) == "number" then
		state.maxArea = math.clamp(math.floor(raw.maxArea), 1, #GameConfig.Areas)
	end
	if type(raw.rebirths) == "number" and raw.rebirths >= 0 then
		state.rebirths = math.floor(raw.rebirths)
	end
	if type(raw.sprinkles) == "number" and raw.sprinkles >= 0 then
		state.sprinkles = math.floor(raw.sprinkles)
	end

	-- Upgrades are read before `carried`, because carry capacity depends on them.
	if type(raw.upgrades) == "table" then
		for _, upgrade in GameConfig.Upgrades do
			local level = raw.upgrades[upgrade.Id]
			if type(level) == "number" and level >= 0 then
				state.upgrades[upgrade.Id] = math.min(math.floor(level), upgrade.MaxLevel)
			end
		end
	end

	-- Runes are read before capacity too: a rune could grant carry space later.
	if type(raw.runes) == "table" then
		for _, rune in GameConfig.Runes do
			local owned = raw.runes[rune.Id]
			if type(owned) == "number" and owned >= 0 then
				state.runes[rune.Id] = math.floor(owned)
			end
		end
	end
	if type(raw.runesOpened) == "number" and raw.runesOpened >= 0 then
		state.runesOpened = math.floor(raw.runesOpened)
	end

	-- `passes` is deliberately NOT read from the save. Ownership is answered by
	-- Roblox on the server every session, so an edited save cannot grant one.

	if type(raw.carried) == "number" and raw.carried >= 0 then
		state.carried = math.min(math.floor(raw.carried), GameConfig.getCapacity(state))
	end
	if type(raw.fed) == "table" then
		for i = 1, #GameConfig.Areas do
			local value = raw.fed[i]
			if type(value) == "number" and value >= 0 then
				state.fed[i] = math.min(math.floor(value), GameConfig.Areas[i].HungerGoal)
			end
		end
	end
	if type(raw.totalFed) == "number" and raw.totalFed >= 0 then
		state.totalFed = math.floor(raw.totalFed)
	end

	return state
end

local function key(player: Player): string
	return `player_{player.UserId}`
end

--[[
	Loads a player's progress, claiming their save first.

	Returns `state, nil` on success, or `nil, reason` when the save could not be
	claimed. A refusal is not an inconvenience to route around -- loading anyway
	would put two servers on the same data, which is precisely the duplication
	SessionLock exists to stop. The caller must kick the player with the reason.
]]
function PlayerState.load(player: Player): (any, string?)
	local raw = nil
	if store then
		local claim = SessionLock.claim(store, key(player))
		if not claim.ok then
			return nil, claim.reason or "Could not open your save."
		end
		raw = claim.data
	end

	local state = sanitize(raw)
	states[player] = state
	return state, nil
end

function PlayerState.get(player: Player)
	return states[player]
end

function PlayerState.save(player: Player)
	local state = states[player]
	if not state or not store then
		return
	end
	-- Writes through SessionLock, which refuses if this server no longer owns the
	-- save. Overwriting a claim we lost would roll the other server back.
	SessionLock.save(store, key(player), state)
end

function PlayerState.release(player: Player)
	local state = states[player]
	if state and store then
		-- Save and drop the claim together, so the player can rejoin elsewhere
		-- straight away instead of waiting for the claim to time out.
		SessionLock.release(store, key(player), state)
	end
	states[player] = nil
end

function PlayerState.all()
	return states
end

return PlayerState
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX8">
<Properties>
<string name="Name">WorldBuilder</string>
<ProtectedString name="Source"><![CDATA[
--[[
	WorldBuilder
	Generates the whole map from GameConfig: one floating platform per area, a
	bridge between each pair, a locked gate on every bridge, and a Big Bebeh
	waiting to be fed on each platform.

	Everything lands in Workspace.BigBebehWorld. It is rebuilt from scratch on
	each server start, so you can safely delete it in Studio and hit Play again.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)
local BebehBuilder = require(script.Parent.BebehBuilder)

local WorldBuilder = {}

local WORLD_NAME = "BigBebehWorld"

local function makeAnchoredPart(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function makeSign(text: string, size: UDim2, adornee: BasePart, offsetY: number): BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Sign"
	billboard.Size = size
	billboard.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	billboard.MaxDistance = 300
	billboard.Adornee = adornee

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Parent = billboard

	billboard.Parent = adornee
	return billboard
end

-- A little market stall where Sprinkles get spent.
local function buildShop(areaIndex: number, center: Vector3, cfg: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Shop"
	folder.Parent = parent

	local base = GameConfig.getLandmark(areaIndex, "ShopOffset")

	makeAnchoredPart("Counter", Vector3.new(16, 6, 6), CFrame.new(base + Vector3.new(0, 3, 0)), Color3.fromRGB(168, 128, 92), folder).Material =
		Enum.Material.WoodPlanks
	for _, side in { -1, 1 } do
		makeAnchoredPart(
			"Post",
			Vector3.new(1.2, 14, 1.2),
			CFrame.new(base + Vector3.new(side * 7, 7, -2.6)),
			Color3.fromRGB(140, 104, 74),
			folder
		)
	end

	-- Striped awning.
	for i = -3, 3 do
		makeAnchoredPart(
			"Awning",
			Vector3.new(2.4, 0.6, 9),
			CFrame.new(base + Vector3.new(i * 2.4, 14.5, 0)) * CFrame.Angles(math.rad(-16), 0, 0),
			(i % 2 == 0) and Color3.fromRGB(240, 96, 110) or Color3.fromRGB(250, 246, 238),
			folder
		)
	end

	local sign = makeAnchoredPart(
		"ShopSign",
		Vector3.new(1, 1, 1),
		CFrame.new(base + Vector3.new(0, 19, 0)),
		cfg.AccentColor,
		folder
	)
	sign.Transparency = 1
	sign.CanCollide = false
	makeSign("🛒 UPGRADE SHOP", UDim2.fromScale(16, 4), sign, 0)

	-- Walking up opens the same panel as the on-screen button.
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open shop"
	prompt.ObjectText = "Upgrades"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 16
	prompt.Parent = folder:FindFirstChild("Counter")
	CollectionService:AddTag(prompt, "ShopPrompt")

	return folder
end

--[[
	A wall-mounted upgrade board at the back of the arena. The panels themselves
	are drawn by the client onto a SurfaceGui, because prices and levels are
	per-player; the server only puts up the woodwork.
]]
local function buildUpgradeBoard(areaIndex: number, cfg: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "UpgradeBoard"
	folder.Parent = parent

	local anchor = GameConfig.getLandmark(areaIndex, "BoardOffset")
	-- A part's Front face points down its own -Z. Unrotated, that faces away
	-- from a player walking in, so the GUI rendered on the back of the board.
	-- BoardYaw turns the whole assembly to face the play area.
	local yaw = CFrame.Angles(0, math.rad(GameConfig.Areas[areaIndex].BoardYaw or 180), 0)
	local base = CFrame.new(anchor) * yaw
	local boardWidth, boardHeight = 52, 22

	for _, side in { -1, 1 } do
		makeAnchoredPart(
			"BoardLeg",
			Vector3.new(1.6, 12, 1.6),
			base * CFrame.new(side * (boardWidth / 2 - 2), 6, 0),
			Color3.fromRGB(96, 74, 58),
			folder
		)
	end

	makeAnchoredPart(
		"BoardFrame",
		Vector3.new(boardWidth + 2.4, boardHeight + 2.4, 1.6),
		base * CFrame.new(0, 12 + boardHeight / 2, 0),
		Color3.fromRGB(64, 52, 74),
		folder
	)

	local face = makeAnchoredPart(
		"BoardFace",
		Vector3.new(boardWidth, boardHeight, 1),
		base * CFrame.new(0, 12 + boardHeight / 2, -0.6),
		Color3.fromRGB(30, 27, 40),
		folder
	)
	face.Material = Enum.Material.SmoothPlastic
	CollectionService:AddTag(face, "UpgradeBoard")

	local header = makeAnchoredPart(
		"BoardHeader",
		Vector3.new(1, 1, 1),
		base * CFrame.new(0, 12 + boardHeight + 4, 0),
		cfg.AccentColor,
		folder
	)
	header.Transparency = 1
	header.CanCollide = false
	makeSign("COOKIE UPGRADES", UDim2.fromScale(22, 4), header, 0)

	return folder
end

--[[
	The rune altar. Stand on it and runes open by themselves; the server watches
	the radius, so there is nothing to press.
]]
local function buildRuneAltar(areaIndex: number, cfg: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "RuneAltar"
	folder.Parent = parent

	local base = GameConfig.getLandmark(areaIndex, "AltarOffset")

	local pad = makeAnchoredPart(
		"AltarPad",
		Vector3.new(1.2, GameConfig.RuneAltarRadius * 2, GameConfig.RuneAltarRadius * 2),
		CFrame.new(base + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(150, 110, 240),
		folder
	)
	pad.Shape = Enum.PartType.Cylinder
	pad.CanCollide = false
	pad.CanTouch = false
	pad.Material = Enum.Material.Neon
	pad.Transparency = 0.45

	makeAnchoredPart(
		"AltarPlinth",
		Vector3.new(7, 3.4, 7),
		CFrame.new(base + Vector3.new(0, 1.7, 0)),
		Color3.fromRGB(62, 48, 88),
		folder
	)

	-- A floating crystal to mark the spot.
	local crystal = makeAnchoredPart(
		"AltarCrystal",
		Vector3.new(3.6, 6.4, 3.6),
		CFrame.new(base + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.rad(45)),
		Color3.fromRGB(178, 138, 255),
		folder
	)
	crystal.Material = Enum.Material.Neon
	crystal.CanCollide = false
	CollectionService:AddTag(crystal, "RuneCrystal")

	local sign = makeAnchoredPart(
		"AltarSign",
		Vector3.new(1, 1, 1),
		CFrame.new(base + Vector3.new(0, 16, 0)),
		cfg.AccentColor,
		folder
	)
	sign.Transparency = 1
	sign.CanCollide = false
	makeSign("✦ RUNE ALTAR ✦\nstand here to open", UDim2.fromScale(18, 5), sign, 0)

	return folder
end

--[[
	The cookie pit. Cookies spawn only inside this square, so the rest of the map
	stays clear for the board, the altar and the walk to Big Bebeh. It is sunk a
	little and ringed with a raised kerb so the boundary reads from any angle.
]]
local function buildCookiePit(pitCenter: Vector3, pitSize: Vector2, cfg: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "CookiePit"
	folder.Parent = parent

	local depth = 2.5
	local floor = makeAnchoredPart(
		"PitFloor",
		Vector3.new(pitSize.X, 4, pitSize.Y),
		CFrame.new(pitCenter + Vector3.new(0, -depth - 2, 0)),
		cfg.CookieColor:Lerp(Color3.fromRGB(255, 255, 255), 0.35),
		folder
	)
	floor.Material = Enum.Material.Sand

	-- Raised kerb around the rim, in the area's accent colour.
	local kerbH, kerbW = 2.2, 3.0
	for _, axis in { "X", "Z" } do
		for _, side in { -1, 1 } do
			local size = axis == "X" and Vector3.new(pitSize.X + kerbW * 2, kerbH, kerbW)
				or Vector3.new(kerbW, kerbH, pitSize.Y + kerbW * 2)
			local offset = axis == "X" and Vector3.new(0, -depth + kerbH / 2, side * (pitSize.Y / 2 + kerbW / 2))
				or Vector3.new(side * (pitSize.X / 2 + kerbW / 2), -depth + kerbH / 2, 0)
			makeAnchoredPart("PitKerb", size, CFrame.new(pitCenter + offset), cfg.AccentColor, folder)
		end
	end

	-- Ramps in on the two open sides so nobody has to jump.
	for _, side in { -1, 1 } do
		local ramp = makeAnchoredPart(
			"PitRamp",
			Vector3.new(16, 1, 9),
			CFrame.new(pitCenter + Vector3.new(side * (pitSize.X / 2 + 3), -depth / 2 + 0.4, 0))
				* CFrame.Angles(0, 0, math.rad(side * 16)),
			cfg.AccentColor:Lerp(Color3.new(0, 0, 0), 0.15),
			folder
		)
		ramp.Material = Enum.Material.SmoothPlastic
	end

	return folder
end

-- Scenery so the map is not a bare plane: clumps of bushes and rocks placed
-- outside the pit and clear of the landmarks.
local function buildScenery(areaIndex: number, center: Vector3, size: Vector3, cfg: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	folder.Parent = parent

	local pitCenter, pitSize = GameConfig.getCookiePit(areaIndex)
	local avoid = {
		{ pos = pitCenter, radius = math.max(pitSize.X, pitSize.Y) / 2 + 12 },
		{ pos = GameConfig.getLandmark(areaIndex, "BebehOffset"), radius = 34 },
		{ pos = GameConfig.getLandmark(areaIndex, "AltarOffset"), radius = 26 },
		{ pos = GameConfig.getLandmark(areaIndex, "ShopOffset"), radius = 26 },
		{ pos = GameConfig.getLandmark(areaIndex, "BoardOffset"), radius = 32 },
	}

	local rng = Random.new(areaIndex * 7919)
	local halfX, halfZ = size.X / 2 - 12, size.Z / 2 - 12
	local placed = 0
	for _ = 1, 220 do
		if placed >= 26 then
			break
		end
		local pos = center + Vector3.new(rng:NextNumber(-halfX, halfX), 0, rng:NextNumber(-halfZ, halfZ))
		local ok = true
		for _, zone in avoid do
			if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(zone.pos.X, 0, zone.pos.Z)).Magnitude < zone.radius then
				ok = false
				break
			end
		end
		if ok then
			placed += 1
			if rng:NextNumber() < 0.55 then
				-- Bush: a couple of overlapping spheres.
				for i = 1, 3 do
					local blob = makeAnchoredPart(
						"Bush",
						Vector3.new(rng:NextNumber(4, 7), rng:NextNumber(4, 6), rng:NextNumber(4, 7)),
						CFrame.new(pos + Vector3.new(rng:NextNumber(-2, 2), 1.6, rng:NextNumber(-2, 2))),
						cfg.FloorColor:Lerp(Color3.new(0, 0, 0), 0.25 + i * 0.04),
						folder
					)
					blob.Shape = Enum.PartType.Ball
					blob.CanCollide = false
					blob.Material = Enum.Material.Grass
				end
			else
				local rock = makeAnchoredPart(
					"Rock",
					Vector3.new(rng:NextNumber(4, 8), rng:NextNumber(3, 6), rng:NextNumber(4, 8)),
					CFrame.new(pos + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
					Color3.fromRGB(150, 150, 158),
					folder
				)
				rock.Material = Enum.Material.Slate
			end
		end
	end
	return folder
end

-- One platform, its fence, its name sign and its Bebeh.
local function buildArea(areaIndex: number, parent: Instance)
	local cfg = GameConfig.Areas[areaIndex]
	local center = GameConfig.getAreaCenter(areaIndex)
	local size = GameConfig.getPlatformSize(areaIndex)

	local folder = Instance.new("Folder")
	folder.Name = `Area{areaIndex}_{cfg.Name}`
	folder.Parent = parent

	-- Floor. Its top surface sits exactly at Y = 0.
	local floor = makeAnchoredPart(
		"Floor",
		size,
		CFrame.new(center + Vector3.new(0, -size.Y / 2, 0)),
		cfg.FloorColor,
		folder
	)
	floor.Material = Enum.Material.Grass

	-- A skirt underneath so the platform reads as a floating island.
	makeAnchoredPart(
		"Base",
		Vector3.new(size.X * 0.82, 22, size.Z * 0.82),
		CFrame.new(center + Vector3.new(0, -size.Y - 11, 0)),
		cfg.FloorColor:Lerp(Color3.new(0, 0, 0), 0.4),
		folder
	).Material = Enum.Material.Slate

	-- Low fence around the rim so nobody walks off by accident.
	local fenceHeight = 5
	for _, sz in { -1, 1 } do
		makeAnchoredPart(
			"Fence",
			Vector3.new(size.X, fenceHeight, 2),
			CFrame.new(center + Vector3.new(0, fenceHeight / 2, sz * size.Z / 2)),
			cfg.AccentColor,
			folder
		)
	end

	-- The +X and -X walls have a doorway cut into them wherever a bridge lands:
	-- one on -X unless this is the first area, one on +X unless it is the last.
	local sideRun = (size.Z - GameConfig.BridgeWidth) / 2
	local hasBridge = { [-1] = areaIndex > 1, [1] = areaIndex < #GameConfig.Areas }
	for _, sx in { -1, 1 } do
		if hasBridge[sx] then
			for _, sz in { -1, 1 } do
				makeAnchoredPart(
					"Fence",
					Vector3.new(2, fenceHeight, sideRun),
					CFrame.new(
						center
							+ Vector3.new(sx * size.X / 2, fenceHeight / 2, sz * (GameConfig.BridgeWidth + sideRun) / 2)
					),
					cfg.AccentColor,
					folder
				)
			end
		else
			makeAnchoredPart(
				"Fence",
				Vector3.new(2, fenceHeight, size.Z),
				CFrame.new(center + Vector3.new(sx * size.X / 2, fenceHeight / 2, 0)),
				cfg.AccentColor,
				folder
			)
		end
	end

	-- Area name floating over the middle of the platform.
	local marker = makeAnchoredPart(
		"NameMarker",
		Vector3.new(1, 1, 1),
		CFrame.new(center + Vector3.new(0, 26, 60)),
		cfg.AccentColor,
		folder
	)
	marker.Transparency = 1
	marker.CanCollide = false
	makeSign(`{areaIndex}. {cfg.Name}`, UDim2.fromScale(24, 5), marker, 0)

	-- Big Bebeh, at the back of the platform, facing the middle.
	local bebehPos = GameConfig.getLandmark(areaIndex, "BebehOffset")
	local bebeh = BebehBuilder.build(areaIndex, cfg, CFrame.lookAt(bebehPos, bebehPos + Vector3.new(0, 0, 1)))
	bebeh.Parent = folder

	-- A soft glowing pad so players know where to stand to feed him.
	local diameter = GameConfig.FeedRadius * 2
	local pad = makeAnchoredPart(
		"FeedPad",
		Vector3.new(0.4, diameter, diameter),
		CFrame.new(bebehPos + Vector3.new(0, 0.2, 8)) * CFrame.Angles(0, 0, math.rad(90)),
		cfg.AccentColor,
		folder
	)
	pad.Shape = Enum.PartType.Cylinder
	pad.CanCollide = false
	pad.CanTouch = false
	pad.Material = Enum.Material.Neon
	pad.Transparency = 0.6

	local pitCenter, pitSize = GameConfig.getCookiePit(areaIndex)
	buildCookiePit(pitCenter, pitSize, cfg, folder)
	buildScenery(areaIndex, center, size, cfg, folder)
	buildShop(areaIndex, center, cfg, folder)
	buildUpgradeBoard(areaIndex, cfg, folder)
	buildRuneAltar(areaIndex, cfg, folder)

	return { folder = folder, bebeh = bebeh, center = center }
end

-- The bridge from `areaIndex` to `areaIndex + 1`, plus the gate that blocks it.
local function buildBridge(areaIndex: number, parent: Instance)
	local fromCenter = GameConfig.getAreaCenter(areaIndex)
	local nextCfg = GameConfig.Areas[areaIndex + 1]
	local gapStart = GameConfig.getAreaEdge(areaIndex, 1)
	local gapEnd = GameConfig.getAreaEdge(areaIndex + 1, -1)
	local gapLength = gapEnd - gapStart

	local folder = Instance.new("Folder")
	folder.Name = `Bridge{areaIndex}to{areaIndex + 1}`
	folder.Parent = parent

	local bridgeCenter = Vector3.new((gapStart + gapEnd) / 2, -1.5, fromCenter.Z)
	makeAnchoredPart(
		"Deck",
		Vector3.new(gapLength, 3, GameConfig.BridgeWidth),
		CFrame.new(bridgeCenter),
		Color3.fromRGB(168, 128, 92),
		folder
	).Material = Enum.Material.WoodPlanks

	for _, sz in { -1, 1 } do
		makeAnchoredPart(
			"Rail",
			Vector3.new(gapLength, 4, 1.5),
			CFrame.new(bridgeCenter + Vector3.new(0, 3, sz * GameConfig.BridgeWidth / 2)),
			Color3.fromRGB(120, 88, 62),
			folder
		)
	end

	-- The gate. Solid until this player has fed the Bebeh behind them; the
	-- client turns it off locally once the area is unlocked.
	local gate = makeAnchoredPart(
		"Gate",
		Vector3.new(2, 24, GameConfig.BridgeWidth + 3),
		CFrame.new(Vector3.new(gapStart + 3, 12, fromCenter.Z)),
		nextCfg.AccentColor,
		folder
	)
	gate.Material = Enum.Material.ForceField
	gate.Transparency = 0.35
	gate.CanCollide = true
	gate:SetAttribute("AreaIndex", areaIndex + 1) -- the area this gate leads INTO
	CollectionService:AddTag(gate, "AreaGate")

	makeSign(`🔒 {nextCfg.Name}`, UDim2.fromScale(20, 6), gate, 16)

	return folder
end

function WorldBuilder.build()
	local existing = workspace:FindFirstChild(WORLD_NAME)
	if existing then
		existing:Destroy()
	end
	-- Studio's default baseplate would sit in the middle of everything.
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	local world = Instance.new("Folder")
	world.Name = WORLD_NAME
	world.Parent = workspace

	local areasFolder = Instance.new("Folder")
	areasFolder.Name = "Areas"
	areasFolder.Parent = world

	local cookiesFolder = Instance.new("Folder")
	cookiesFolder.Name = "Cookies"
	cookiesFolder.Parent = world

	local areas = {}
	for i = 1, #GameConfig.Areas do
		areas[i] = buildArea(i, areasFolder)
		if i < #GameConfig.Areas then
			buildBridge(i, areasFolder)
		end
	end

	-- Spawn everyone at the front of area 1.
	for _, old in workspace:GetDescendants() do
		if old:IsA("SpawnLocation") and not old:IsDescendantOf(world) then
			old:Destroy()
		end
	end
	local spawnPart = Instance.new("SpawnLocation")
	spawnPart.Name = "BebehSpawn"
	spawnPart.Size = Vector3.new(12, 1, 12)
	spawnPart.CFrame = CFrame.new(GameConfig.getAreaCenter(1) + Vector3.new(0, 0.5, 80))
	spawnPart.Anchored = true
	spawnPart.Color = GameConfig.Areas[1].AccentColor
	spawnPart.Material = Enum.Material.Neon
	spawnPart.Duration = 0
	spawnPart.Parent = world

	return {
		world = world,
		areas = areas,
		cookiesFolder = cookiesFolder,
	}
end

return WorldBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX9">
<Properties>
<string name="Name">BebehBuilder</string>
<ProtectedString name="Source"><![CDATA[
--[[
	BebehBuilder
	Builds Big Bebeh: a chunky rounded brown head, long floppy yellow ears,
	sleepy arced eyes, blushy cheeks, a blue bib and a big blue pacifier.

	Three ways to get a Bebeh, in priority order:
	  1. A Model named "BigBebeh" in ServerStorage — cloned and scaled. This is
	     what you get after importing models/BigBebeh.fbx (see the README).
	  2. GameConfig.BebehImageId — a flat cutout of your own artwork.
	  3. Otherwise, the part-built one below.

	Roblox has no rounded-box primitive, so the chunky shapes here are built the
	way modelling packages do it: a core of slabs, cylinders along the edges and
	spheres at the corners. That is what stops him reading as a stack of bricks.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)

local BebehBuilder = {}

local BROWN = Color3.fromRGB(150, 104, 66)
local BROWN_DARK = Color3.fromRGB(106, 68, 40)
local EAR_YELLOW = Color3.fromRGB(247, 226, 30)
local EAR_YELLOW_DARK = Color3.fromRGB(222, 188, 18)
local BIB_BLUE = Color3.fromRGB(108, 204, 238)
local BIB_BLUE_LIGHT = Color3.fromRGB(132, 215, 243)
local PACI_BLUE = Color3.fromRGB(48, 128, 222)
local PACI_KNOB = Color3.fromRGB(104, 186, 246)
local PACI_PURPLE = Color3.fromRGB(134, 106, 205)
local BLUSH = Color3.fromRGB(226, 118, 104)
local DIAPER = Color3.fromRGB(248, 246, 240)
local INK = Color3.fromRGB(20, 18, 18)

-- How tall an imported Bebeh should stand at BebehScale = 1. The part-built one
-- is about this height, so the feed radius and camera framing stay tuned.
local IMPORT_TARGET_HEIGHT = 33

--[[
	Colours for an imported mesh, keyed by the object names the Blender script
	uses. Roblox's 3D importer carries those names onto the MeshParts, so a
	freshly imported model can be tinted without anyone editing it by hand.
	Longest prefix wins, so "EarInner" beats "Ear" and "HeadSide" beats "Head".
]]
local MESH_COLORS: { [string]: Color3 } = {
	Head = BROWN,
	HeadSide = BROWN_DARK,
	Stripe = EAR_YELLOW,
	Ear = EAR_YELLOW,
	EarInner = EAR_YELLOW_DARK,
	Eye = INK,
	Blush = BLUSH,
	Bib = BIB_BLUE,
	Bow = BIB_BLUE_LIGHT,
	PaciShield = PACI_BLUE,
	PaciDot = Color3.fromRGB(36, 104, 178),
	PaciKnob = PACI_KNOB,
	PaciRing = PACI_PURPLE,
	Diaper = DIAPER,
	Foot = BROWN,
	Tail = EAR_YELLOW,
	CookieBase = Color3.fromRGB(210, 154, 92),
	CookieChip = Color3.fromRGB(72, 42, 26),
}

local MESH_COLOR_KEYS: { string } = {}
for key in MESH_COLORS do
	table.insert(MESH_COLOR_KEYS, key)
end
table.sort(MESH_COLOR_KEYS, function(a, b)
	return #a > #b
end)

function BebehBuilder.colorFor(partName: string): Color3?
	for _, key in MESH_COLOR_KEYS do
		if string.sub(partName, 1, #key) == key then
			return MESH_COLORS[key]
		end
	end
	return nil
end

--[[
	Tints every part of an imported model by name and makes it inert: nothing
	collides or fires touch events, because the caller adds one clean collider.
	Returns how many parts were recognised, so a mismatched model can be spotted.
]]
function BebehBuilder.styleImported(model: Model): number
	local matched = 0
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Material = Enum.Material.SmoothPlastic
			local color = BebehBuilder.colorFor(part.Name)
			if color then
				part.Color = color
				matched += 1
			end
		end
	end
	return matched
end

--[[
	Rescales a model so it stands `targetHeight` studs tall, then applies the
	area's own multiplier. Studio's 3D importer picks its own unit scale, so
	without this an imported Bebeh could arrive any size at all.
]]
function BebehBuilder.normalizeHeight(model: Model, targetHeight: number, scale: number)
	local ok = pcall(function()
		model:ScaleTo(1)
	end)
	if not ok then
		return
	end
	local _, size = model:GetBoundingBox()
	if size.Y <= 0.001 then
		return
	end
	pcall(function()
		model:ScaleTo((targetHeight / size.Y) * scale)
	end)
end

--[[
	Collects parts as we go. Every piece is authored around the origin with the
	face pointing down -Z, then the whole model is moved into place at the end.
]]
local function newBuilder(scale: number)
	local pieces: { Part } = {}

	local function s(n: number)
		return n * scale
	end

	local function add(name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Shape = shape or Enum.PartType.Block
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		table.insert(pieces, p)
		return p
	end

	-- A box with every edge and corner rounded off: 3 slabs + 12 edges + 8 corners.
	local function roundedBox(name: string, size: Vector3, cf: CFrame, color: Color3, radius: number, material: Enum.Material?)
		local r = math.min(radius, size.X / 2, size.Y / 2, size.Z / 2)
		local ix, iy, iz = size.X - 2 * r, size.Y - 2 * r, size.Z - 2 * r
		local d = r * 2

		add(name, Vector3.new(size.X, iy, iz), cf, color, nil, material)
		add(name, Vector3.new(ix, size.Y, iz), cf, color, nil, material)
		add(name, Vector3.new(ix, iy, size.Z), cf, color, nil, material)

		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				-- Edges running along X, then Y, then Z.
				add(name, Vector3.new(ix, d, d), cf * CFrame.new(0, a * iy / 2, b * iz / 2), color, Enum.PartType.Cylinder, material)
				add(
					name,
					Vector3.new(iy, d, d),
					cf * CFrame.new(a * ix / 2, 0, b * iz / 2) * CFrame.Angles(0, 0, math.rad(90)),
					color,
					Enum.PartType.Cylinder,
					material
				)
				add(
					name,
					Vector3.new(iz, d, d),
					cf * CFrame.new(a * ix / 2, b * iy / 2, 0) * CFrame.Angles(0, math.rad(90), 0),
					color,
					Enum.PartType.Cylinder,
					material
				)
			end
		end

		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				for _, c in { -1, 1 } do
					add(
						name,
						Vector3.new(d, d, d),
						cf * CFrame.new(a * ix / 2, b * iy / 2, c * iz / 2),
						color,
						Enum.PartType.Ball,
						material
					)
				end
			end
		end
	end

	-- A flat slab with only its outline rounded — for ears, bibs and stripes.
	local function roundedPlate(name: string, size: Vector3, cf: CFrame, color: Color3, radius: number, material: Enum.Material?)
		local r = math.min(radius, size.X / 2, size.Y / 2)
		local ix, iy = size.X - 2 * r, size.Y - 2 * r
		local d = r * 2

		add(name, Vector3.new(size.X, iy, size.Z), cf, color, nil, material)
		add(name, Vector3.new(ix, size.Y, size.Z), cf, color, nil, material)
		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				add(
					name,
					Vector3.new(size.Z, d, d),
					cf * CFrame.new(a * ix / 2, b * iy / 2, 0) * CFrame.Angles(0, math.rad(90), 0),
					color,
					Enum.PartType.Cylinder,
					material
				)
			end
		end
	end

	return {
		pieces = pieces,
		s = s,
		add = add,
		roundedBox = roundedBox,
		roundedPlate = roundedPlate,
	}
end

local function buildBlockyBebeh(scale: number): Model
	local model = Instance.new("Model")
	local b = newBuilder(scale)
	local s, add = b.s, b.add

	local function at(x: number, y: number, z: number)
		return CFrame.new(s(x), s(y), s(z))
	end
	local function v(x: number, y: number, z: number)
		return Vector3.new(s(x), s(y), s(z))
	end

	local faceZ = -6.5 -- the front plane of the head

	-- Head -------------------------------------------------------------------
	b.roundedBox("Head", v(14, 13, 13), at(0, 0, 0), BROWN, s(2.6))

	-- Shading down his left side, and the yellow stripe from the reference.
	b.roundedPlate("SideShade", v(9, 11, 0.4), at(-7.05, 0, 0) * CFrame.Angles(0, math.rad(90), 0), BROWN_DARK, s(1.5))
	b.roundedPlate("Stripe", v(9.4, 3.2, 0.4), at(-7.15, 0.4, 0.6) * CFrame.Angles(0, math.rad(90), 0), EAR_YELLOW, s(1.4))

	-- Ears -------------------------------------------------------------------
	-- Two segments each so they taper and flop outward instead of standing stiff.
	for _, side in { -1, 1 } do
		local root = at(side * 3.4, 6.2, 0.4) * CFrame.Angles(math.rad(-10), 0, math.rad(side * 34))
		b.roundedPlate("Ear", v(3.4, 9, 1.1), root * CFrame.new(0, s(4.2), 0), EAR_YELLOW, s(1.5))
		-- The outer half bends a little further out, giving the floppy silhouette.
		local tip = root * CFrame.new(0, s(8.4), 0) * CFrame.Angles(0, 0, math.rad(side * 12))
		b.roundedPlate("EarTip", v(2.6, 7, 1.05), tip * CFrame.new(0, s(3.2), 0), EAR_YELLOW, s(1.2))
		b.roundedPlate("EarInner", v(1.5, 5.2, 0.3), root * CFrame.new(0, s(4.6), s(-0.5)), EAR_YELLOW_DARK, s(0.7))
	end

	-- Eyes -------------------------------------------------------------------
	-- Sleepy closed eyes, drawn as an arc of beads peaking in the middle.
	for _, side in { -1, 1 } do
		for i = 0, 6 do
			local t = (i / 6) * 2 - 1
			add(
				"Eye",
				v(0.9, 0.9, 0.5),
				at(side * 3.7 + t * 2.0, 2.5 - 1.35 * t * t, faceZ - 0.05),
				INK,
				Enum.PartType.Ball
			)
		end
	end

	-- Blush ------------------------------------------------------------------
	for _, side in { -1, 1 } do
		local cheek = add("Blush", v(3.8, 2.3, 0.9), at(side * 4.7, -0.4, faceZ), BLUSH, Enum.PartType.Ball)
		cheek.Transparency = 0.4
	end

	-- Bib --------------------------------------------------------------------
	b.roundedPlate("Bib", v(13, 4.6, 0.8), at(0, -4.3, faceZ - 0.25), BIB_BLUE, s(2))
	-- Shoulder straps sweeping up either side.
	for _, side in { -1, 1 } do
		b.roundedPlate(
			"BibStrap",
			v(3.4, 4.6, 0.8),
			at(side * 6.1, -2.2, faceZ - 0.25) * CFrame.Angles(0, 0, math.rad(side * -28)),
			BIB_BLUE,
			s(1.4)
		)
	end
	-- Bow.
	for _, side in { -1, 1 } do
		b.roundedPlate(
			"BowLoop",
			v(2.6, 1.9, 0.7),
			at(side * 1.9, -5.9, faceZ - 0.7) * CFrame.Angles(0, 0, math.rad(side * 20)),
			BIB_BLUE_LIGHT,
			s(0.85)
		)
	end
	add("BowKnot", v(1.3, 1.3, 1.3), at(0, -5.8, faceZ - 0.85), BIB_BLUE_LIGHT, Enum.PartType.Ball)

	-- Pacifier ---------------------------------------------------------------
	add("PaciShield", v(6, 4, 1.8), at(0, -2.3, faceZ - 0.8), PACI_BLUE, Enum.PartType.Ball)
	add("PaciKnob", v(3, 3, 2.6), at(0, -2.1, faceZ - 1.9), PACI_KNOB, Enum.PartType.Ball)
	-- The ring is a circle of beads, which reads as a torus from any angle.
	for i = 0, 11 do
		local angle = (i / 12) * math.pi * 2
		add(
			"PaciRing",
			v(1.05, 1.05, 1.05),
			at(0, -3.5, faceZ - 2.7) * CFrame.new(math.cos(angle) * s(1.9), math.sin(angle) * s(1.9), 0),
			PACI_PURPLE,
			Enum.PartType.Ball
		)
	end

	-- Body -------------------------------------------------------------------
	b.roundedBox("Diaper", v(13.2, 4, 13.2), at(0, -7.8, 0), DIAPER, s(1.8))
	for _, side in { -1, 1 } do
		add("Foot", v(4.4, 2.8, 5.8), at(side * 3.5, -10.2, -1.8), BROWN, Enum.PartType.Ball)
	end
	add("Tail", v(3, 3, 3), at(0, -8.4, 7.2), EAR_YELLOW, Enum.PartType.Ball)

	-- One invisible box does all the colliding, so players bump into a clean
	-- shape instead of catching on ears and pacifier beads.
	local collider = add("Collider", v(14.5, 22, 14), at(0, -4, 0), BROWN)
	collider.Transparency = 1
	collider.CanCollide = true
	collider.CanQuery = true
	model.PrimaryPart = collider

	for _, p in b.pieces do
		p.Parent = model
	end
	return model
end

-- A flat cutout of the user's own artwork, printed on both faces.
local function buildImageBebeh(scale: number, imageId: string): Model
	local model = Instance.new("Model")

	local height = 24 * scale
	local width = height * GameConfig.BebehImageAspect

	local board = Instance.new("Part")
	board.Name = "Bebeh"
	board.Size = Vector3.new(width, height, 0.6)
	board.CFrame = CFrame.new(0, 0, 0)
	board.Anchored = true
	board.CanCollide = true
	board.CanTouch = false
	board.Transparency = 1 -- decals still draw on an invisible part
	board.Parent = model
	model.PrimaryPart = board

	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local decal = Instance.new("Decal")
		decal.Texture = imageId
		decal.Face = face
		decal.Parent = board
	end

	return model
end

--[[
	Builds one Bebeh for an area.
	@param areaIndex  which area this Bebeh belongs to
	@param areaConfig the entry from GameConfig.Areas
	@param pivot      where to stand him, already facing the right way
]]
function BebehBuilder.build(areaIndex: number, areaConfig: any, pivot: CFrame): Model
	local scale = areaConfig.BebehScale

	local model: Model
	local imported = false
	local template = ServerStorage:FindFirstChild("BigBebeh")
	if template and template:IsA("Model") then
		model = template:Clone()
		imported = true
		if BebehBuilder.styleImported(model) == 0 then
			warn("[BigBebeh] Imported model had no recognisable part names; leaving its colours alone.")
		end
		BebehBuilder.normalizeHeight(model, IMPORT_TARGET_HEIGHT, scale)
	elseif GameConfig.BebehImageId ~= "" then
		model = buildImageBebeh(scale, GameConfig.BebehImageId)
	else
		model = buildBlockyBebeh(scale)
	end

	model.Name = areaConfig.BebehName
	model:PivotTo(pivot)

	-- Lift him so his feet rest on the platform instead of sinking into it.
	-- Measuring after the move keeps this correct for custom models too.
	local boxCFrame, size = model:GetBoundingBox()
	local bottom = boxCFrame.Position.Y - size.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, pivot.Position.Y - bottom, 0))
	model:SetAttribute("AreaIndex", areaIndex)

	-- An imported mesh has no collider of its own, and letting every ear and
	-- pacifier bead collide would snag players. One clean box around the body
	-- does the job, and doubles as a stable PrimaryPart for the animation.
	if imported then
		local box, bodySize = model:GetBoundingBox()
		local collider = Instance.new("Part")
		collider.Name = "Collider"
		collider.Size = Vector3.new(bodySize.X * 0.5, bodySize.Y * 0.66, bodySize.Z * 0.6)
		collider.CFrame = CFrame.new(box.Position - Vector3.new(0, bodySize.Y * 0.15, 0))
		collider.Anchored = true
		collider.Transparency = 1
		collider.CanCollide = true
		collider.CanTouch = false
		collider.Parent = model
		model.PrimaryPart = collider
	end

	-- Floating nameplate. The numbers are per-player, so the client fills them in.
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "BebehStatus"
	billboard.Size = UDim2.fromScale(14, 4.2)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, size.Y / 2 + 4 * scale, 0)
	billboard.MaxDistance = 220
	billboard.AlwaysOnTop = false

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.42)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.Text = areaConfig.BebehName
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextStrokeTransparency = 0
	title.TextScaled = true
	title.Parent = billboard

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.Position = UDim2.fromScale(0, 0.44)
	status.Size = UDim2.fromScale(1, 0.3)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.GothamBold
	status.Text = "Bring me cookies!"
	status.TextColor3 = Color3.fromRGB(255, 240, 170)
	status.TextStrokeTransparency = 0.2
	status.TextScaled = true
	status.Parent = billboard

	local barBack = Instance.new("Frame")
	barBack.Name = "BarBack"
	barBack.Position = UDim2.fromScale(0.1, 0.78)
	barBack.Size = UDim2.fromScale(0.8, 0.16)
	barBack.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	barBack.BorderSizePixel = 0
	barBack.Parent = billboard
	Instance.new("UICorner").Parent = barBack

	local barFill = Instance.new("Frame")
	barFill.Name = "BarFill"
	barFill.Size = UDim2.fromScale(0, 1)
	barFill.BackgroundColor3 = Color3.fromRGB(255, 196, 60)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack
	Instance.new("UICorner").Parent = barFill

	-- Custom models may not set a PrimaryPart, so fall back to any part.
	local anchorPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	billboard.Adornee = anchorPart
	billboard.Parent = anchorPart or model

	CollectionService:AddTag(model, "BigBebeh")
	return model
end

return BebehBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX10">
<Properties>
<string name="Name">AntiCheat</string>
<ProtectedString name="Source"><![CDATA[
--[[
	AntiCheat
	Server-side detection, throttling and reporting.

	Read this first, because it decides how much the rest is worth:

	An exploiter runs arbitrary Lua on their own machine. Anything a LocalScript
	checks, they can delete. So there is no such thing as client-side anti-cheat --
	only server checks, and speed bumps that catch people who are not really
	trying. Everything in this file runs on the server.

	What actually protects the game is that the server owns the economy: the
	client asks for an upgrade by name and the server decides the price, cookies
	are added by the server after a distance check, and nothing the client sends
	is ever used as a number. That was already true before this file existed.

	What this file adds is the layer around it:

	  * throttling, so a remote cannot be spammed thousands of times a second
	  * movement checks, because Roblox hands the client authority over its own
	    character -- speed and flight are the one thing they really can fake
	  * a strike system, so one lag spike is not a ban but a pattern is
	  * a Discord report with the player's name, id and a profile link

	Roblox's own physics ownership means movement checks will occasionally fire on
	a laggy player. That is why the thresholds are generous and why a single
	detection does nothing on its own.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.BigBebehShared.GameConfig)

local AntiCheat = {}

-- Settings -----------------------------------------------------------------

--[[
	Discord will NOT accept a webhook posted straight from a Roblox server. It
	blocks Roblox's address range, and you get a 403 with nothing useful in it.
	You need a tiny proxy in between; the README has a Cloudflare Worker that does
	it in about ten lines, and it is free.

	Put the PROXY url here, not the raw discord.com one.
	Leave it empty and reports go to the Output window instead.
]]
AntiCheat.WebhookUrl = ""

AntiCheat.Settings = {
	-- Strikes needed before each consequence. Strikes decay, so somebody who
	-- trips one check once an hour never escalates; somebody flying does.
	KickAt = 6,
	BanAt = 0, -- 0 disables banning. Try KickAt-only first and watch the channel.
	StrikeDecay = 300, -- seconds for one strike to fall off

	-- Movement. Tolerances are deliberately loose: Roblox gives the client
	-- physics ownership of its own character, so a lag spike genuinely does look
	-- like a short teleport.
	SampleInterval = 0.5,
	SpeedTolerance = 1.6, -- multiple of the player's legitimate walk speed
	SpeedGraceStuds = 8, -- absorbed per sample, on top of the tolerance
	SpeedStrikesNeeded = 3, -- consecutive bad samples before it counts at all
	TeleportStuds = 150, -- a single sample longer than this is not lag
	FlightSeconds = 6, -- airborne this long without falling

	-- Remotes. Generous next to real play, tiny next to a spam loop.
	Limits = {
		BuyUpgrade = { perSecond = 8, burst = 16 },
		Rebirth = { perSecond = 1, burst = 3 },
		SyncState = { perSecond = 4, burst = 8 },
	},

	-- Reporting
	FlushInterval = 3, -- seconds between Discord posts
	MaxEmbedsPerPost = 10, -- Discord's own limit
	AggregateWindow = 30, -- repeats of the same rule collapse into one report
}

-- Severity decides the colour of the Discord embed and the strike weight.
local RULES = {
	Speed = { strikes = 1, color = 0xF1C40F, icon = "🏃" },
	Teleport = { strikes = 2, color = 0xE67E22, icon = "✈️" },
	Flight = { strikes = 2, color = 0xE67E22, icon = "🪂" },
	RemoteSpam = { strikes = 1, color = 0x3498DB, icon = "📡" },
	BadPayload = { strikes = 3, color = 0x9B59B6, icon = "📦" },
	Invariant = { strikes = 4, color = 0xE74C3C, icon = "🧮" },
	SessionLock = { strikes = 0, color = 0x95A5A6, icon = "🔒" },
}

-- State --------------------------------------------------------------------

type Tracker = {
	strikes: number,
	lastStrike: number,
	buckets: { [string]: { tokens: number, at: number } },
	lastPosition: Vector3?,
	lastSample: number,
	badSpeedRun: number,
	airborneSince: number?,
	pardonUntil: number,
	reported: { [string]: number },
}

local trackers: { [Player]: Tracker } = {}
local queue: { any } = {}
local banStore: DataStore? = nil

if AntiCheat.Settings.BanAt > 0 then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("BigBebehBans_v1")
	end)
	if ok then
		banStore = result
	else
		warn(`[AntiCheat] Ban store unavailable, bans disabled: {result}`)
	end
end

local function tracker(player: Player): Tracker?
	return trackers[player]
end

-- Reporting ----------------------------------------------------------------

local function describeServer(): string
	if RunService:IsStudio() then
		return "Studio"
	end
	return `Place {game.PlaceId} · Server {string.sub(game.JobId, 1, 8)}`
end

--[[
	Queues one report. Nothing is posted here: a player who is flying trips the
	check every half second, and firing a webhook each time would get the webhook
	rate-limited by Discord and drown the channel. The flush loop batches, and
	repeats of the same rule inside AggregateWindow collapse into a count.
]]
local function report(player: Player, kind: string, detail: string, strikes: number)
	local rule = RULES[kind] or { color = 0x7F8C8D, icon = "❓" }
	local now = os.clock()
	local track = tracker(player)

	if track then
		local key = kind
		local last = track.reported[key]
		if last and now - last < AntiCheat.Settings.AggregateWindow then
			-- Already reported recently. Find the pending embed and bump its count
			-- rather than adding another one.
			for _, entry in queue do
				if entry.userId == player.UserId and entry.kind == kind then
					entry.count += 1
					entry.detail = detail
					entry.strikes = strikes
					return
				end
			end
		end
		track.reported[key] = now
	end

	table.insert(queue, {
		userId = player.UserId,
		name = player.Name,
		displayName = player.DisplayName,
		kind = kind,
		icon = rule.icon,
		color = rule.color,
		detail = detail,
		strikes = strikes,
		count = 1,
		at = DateTime.now():ToIsoDate(),
	})
end

local function buildEmbed(entry: any): any
	local title = `{entry.icon} {entry.kind}`
	if entry.count > 1 then
		title ..= ` (x{entry.count})`
	end

	return {
		title = title,
		color = entry.color,
		fields = {
			{
				name = "Player",
				value = `[{entry.displayName} (@{entry.name})](https://www.roblox.com/users/{entry.userId}/profile)`,
				inline = true,
			},
			{ name = "User ID", value = tostring(entry.userId), inline = true },
			{ name = "Strikes", value = `{entry.strikes} / {AntiCheat.Settings.KickAt}`, inline = true },
			-- Discord rejects a field longer than 1024 characters and drops the
			-- whole message, so this is cut short rather than risked.
			{ name = "Detail", value = string.sub(entry.detail, 1, 1000), inline = false },
		},
		footer = { text = describeServer() },
		timestamp = entry.at,
	}
end

local function flush()
	if #queue == 0 then
		return
	end

	local batch = {}
	for _ = 1, math.min(#queue, AntiCheat.Settings.MaxEmbedsPerPost) do
		table.insert(batch, buildEmbed(table.remove(queue, 1)))
	end

	if AntiCheat.WebhookUrl == "" then
		for _, embed in batch do
			warn(`[AntiCheat] {embed.title} — {embed.fields[1].value} — {embed.fields[4].value}`)
		end
		return
	end

	local body = HttpService:JSONEncode({
		username = "Big Bebeh Anti-Cheat",
		embeds = batch,
	})

	local ok, err = pcall(function()
		HttpService:PostAsync(AntiCheat.WebhookUrl, body, Enum.HttpContentType.ApplicationJson)
	end)

	if not ok then
		-- A broken webhook must never take the game down with it, so this only
		-- complains. The detection and the kick already happened.
		warn(`[AntiCheat] Webhook post failed: {err}`)
	end
end

-- Strikes ------------------------------------------------------------------

local function punish(player: Player, track: Tracker, kind: string)
	local settings = AntiCheat.Settings

	if settings.BanAt > 0 and track.strikes >= settings.BanAt and banStore then
		pcall(function()
			banStore:SetAsync(`ban_{player.UserId}`, {
				at = os.time(),
				reason = kind,
			})
		end)
		player:Kick("You have been banned for exploiting.")
		return
	end

	if track.strikes >= settings.KickAt then
		player:Kick("Kicked for exploiting. If you think this is wrong, rejoin and play normally.")
	end
end

--[[
	Records a detection. `detail` is the human-readable evidence -- the numbers
	that made this look wrong -- and ends up in the Discord embed, so make it
	specific enough to tell a real exploiter from a laggy player.
]]
function AntiCheat.flag(player: Player, kind: string, detail: string)
	local track = tracker(player)
	if not track then
		return
	end

	local rule = RULES[kind]
	local weight = if rule then rule.strikes else 1
	local now = os.clock()

	-- Decay before adding, so an old strike does not stack with a new one.
	local elapsed = now - track.lastStrike
	local decayed = math.floor(elapsed / AntiCheat.Settings.StrikeDecay)
	if decayed > 0 then
		track.strikes = math.max(0, track.strikes - decayed)
	end

	track.strikes += weight
	track.lastStrike = now

	report(player, kind, detail, track.strikes)
	punish(player, track, kind)
end

-- Throttling ---------------------------------------------------------------

--[[
	Token bucket. Returns false when the player is over their allowance for this
	key, which the caller should treat as "ignore this request" -- not as proof of
	cheating, because a double click is not an attack. Sustained abuse flags
	itself once the bucket has been empty for a while.

	Rate limiting is not optional decoration: without it, one client can call a
	remote in a tight loop and make the server do that work thousands of times a
	second, which costs you the server rather than the economy.
]]
function AntiCheat.allow(player: Player, key: string): boolean
	local track = tracker(player)
	if not track then
		return false
	end

	local limit = AntiCheat.Settings.Limits[key]
	if not limit then
		return true
	end

	local now = os.clock()
	local bucket = track.buckets[key]
	if not bucket then
		bucket = { tokens = limit.burst, at = now }
		track.buckets[key] = bucket
	end

	bucket.tokens = math.min(limit.burst, bucket.tokens + (now - bucket.at) * limit.perSecond)
	bucket.at = now

	if bucket.tokens < 1 then
		-- Far past empty means a loop, not a fast player.
		if bucket.tokens < -limit.burst then
			bucket.tokens = 0
			AntiCheat.flag(player, "RemoteSpam", `Flooded {key}: over {limit.perSecond}/s allowance`)
		else
			bucket.tokens -= 1
		end
		return false
	end

	bucket.tokens -= 1
	return true
end

-- Movement -----------------------------------------------------------------

--[[
	The game teleports players itself -- rebirth, the void catcher, respawns. Each
	of those looks exactly like a teleport exploit from the outside, so whoever
	does the teleporting has to say so.
]]
function AntiCheat.pardon(player: Player, seconds: number?)
	local track = tracker(player)
	if not track then
		return
	end
	track.pardonUntil = os.clock() + (seconds or 3)
	track.lastPosition = nil
	track.badSpeedRun = 0
	track.airborneSince = nil
end

local function sampleMovement(player: Player, track: Tracker, state: any)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		track.lastPosition = nil
		return
	end

	local now = os.clock()
	if now < track.pardonUntil then
		return
	end

	local position = root.Position
	local previous = track.lastPosition
	local dt = now - track.lastSample
	track.lastPosition = position
	track.lastSample = now

	if not previous or dt <= 0 then
		return
	end

	-- Horizontal only: falling is not running, and a long drop would otherwise
	-- read as a speed hack.
	local moved = (Vector3.new(position.X, 0, position.Z) - Vector3.new(previous.X, 0, previous.Z)).Magnitude

	if moved > AntiCheat.Settings.TeleportStuds then
		AntiCheat.flag(player, "Teleport", `Moved {math.floor(moved)} studs in {string.format("%.2f", dt)}s`)
		track.badSpeedRun = 0
		return
	end

	local allowed = GameConfig.getWalkSpeed(state) * AntiCheat.Settings.SpeedTolerance * dt
		+ AntiCheat.Settings.SpeedGraceStuds

	if moved > allowed then
		track.badSpeedRun += 1
		-- One bad sample is lag. Several in a row is not.
		if track.badSpeedRun >= AntiCheat.Settings.SpeedStrikesNeeded then
			AntiCheat.flag(
				player,
				"Speed",
				`{math.floor(moved / dt)} studs/s over {track.badSpeedRun} samples, allowed {math.floor(GameConfig.getWalkSpeed(state))}`
			)
			track.badSpeedRun = 0
		end
	else
		track.badSpeedRun = 0
	end

	-- Flight: off the ground, and not falling. A long jump or a fall off the map
	-- both end with the player losing height, so height that holds or climbs for
	-- several seconds is the tell.
	if humanoid.FloorMaterial == Enum.Material.Air then
		if not track.airborneSince then
			track.airborneSince = now
		elseif position.Y >= previous.Y - 0.5 and now - track.airborneSince > AntiCheat.Settings.FlightSeconds then
			AntiCheat.flag(
				player,
				"Flight",
				`Airborne {math.floor(now - track.airborneSince)}s at Y={math.floor(position.Y)} without falling`
			)
			track.airborneSince = now -- restart, so it reports at most once per window
		end
	else
		track.airborneSince = nil
	end
end

-- Lifecycle ----------------------------------------------------------------

function AntiCheat.isBanned(userId: number): boolean
	if not banStore then
		return false
	end
	local ok, record = pcall(function()
		return banStore:GetAsync(`ban_{userId}`)
	end)
	return ok and type(record) == "table"
end

function AntiCheat.watch(player: Player)
	trackers[player] = {
		strikes = 0,
		lastStrike = os.clock(),
		buckets = {},
		lastPosition = nil,
		lastSample = os.clock(),
		badSpeedRun = 0,
		airborneSince = nil,
		-- Joining, loading and spawning all move the character around, so the
		-- first few seconds are never evidence of anything.
		pardonUntil = os.clock() + 10,
		reported = {},
	}

	player.CharacterAdded:Connect(function()
		AntiCheat.pardon(player, 5)
	end)
end

function AntiCheat.forget(player: Player)
	trackers[player] = nil
end

--[[
	`getState` is passed in rather than required, because AntiCheat sits below
	PlayerState and requiring upwards would be a loop. It should return the
	player's state table, or nil if they have not finished loading.
]]
function AntiCheat.start(getState: (Player) -> any)
	task.spawn(function()
		while true do
			task.wait(AntiCheat.Settings.SampleInterval)
			for player, track in trackers do
				if player.Parent == nil then
					continue
				end
				local state = getState(player)
				if not state then
					continue
				end
				local ok, err = pcall(sampleMovement, player, track, state)
				if not ok then
					warn(`[AntiCheat] Movement check errored for {player.Name}: {err}`)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AntiCheat.Settings.FlushInterval)
			local ok, err = pcall(flush)
			if not ok then
				warn(`[AntiCheat] Report flush errored: {err}`)
			end
		end
	end)

	-- Anything still queued when the server closes would otherwise be lost.
	game:BindToClose(function()
		pcall(flush)
	end)
end

-- Lets the rest of the game report things AntiCheat cannot see for itself, such
-- as a save that failed its own sanity check.
function AntiCheat.note(player: Player, kind: string, detail: string)
	if not trackers[player] then
		AntiCheat.watch(player)
	end
	AntiCheat.flag(player, kind, detail)
end

return AntiCheat
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX11">
<Properties>
<string name="Name">SessionLock</string>
<ProtectedString name="Source"><![CDATA[
--[[
	SessionLock
	Stops the only real dupe this game has: the cross-server rollback.

	The trick players use is to be in two servers at once. Server A loads your
	save, server B loads the same save, you spend in one and bank in the other,
	and whichever writes last wins -- so the currency you spent is still there.
	Nothing inside the game loop can prevent that, because both servers are
	behaving correctly on stale data.

	The fix is to make "who owns this save" a single value that only one server
	can hold. Every session claims the key before loading, refreshes the claim
	while it plays, and drops it on the way out. A second server that finds a
	live claim refuses to load rather than starting from stale data.

	UpdateAsync is what makes this safe: it reads and writes in one atomic
	operation, so two servers claiming at the same instant cannot both win.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local SessionLock = {}

-- How long a claim stays valid without a refresh. A server that crashes cannot
-- release its claim, so the claim has to expire on its own -- otherwise a crash
-- would lock a player out of their own save forever. Long enough to survive a
-- slow autosave, short enough that a crash is a brief annoyance.
local LOCK_TTL = 90
local REFRESH_INTERVAL = 30

-- Studio has no reliable JobId, and running two Studio sessions against the same
-- key is normal while testing, so the lock identifies the server by JobId and
-- falls back to a random id.
local SERVER_ID = if RunService:IsStudio() or game.JobId == ""
	then `studio-{math.random(1, 1e9)}`
	else game.JobId

local held: { [string]: boolean } = {}

export type ClaimResult = {
	ok: boolean,
	reason: string?, -- set when ok is false, safe to show the player
	data: any, -- the saved value, only when ok is true
}

--[[
	Claims the key and hands back whatever was stored with it.

	`ok = false` means somebody else holds it. That is not an error to swallow --
	loading anyway is exactly the dupe this module exists to prevent, so the
	caller must refuse to let the player play.
]]
function SessionLock.claim(store: DataStore, key: string): ClaimResult
	local now = os.time()
	local rejected: string? = nil

	local ok, err = pcall(function()
		store:UpdateAsync(key, function(record)
			record = if type(record) == "table" then record else {}
			local lock = record.__lock

			-- A claim from another server that has not expired yet.
			if
				type(lock) == "table"
				and lock.server ~= SERVER_ID
				and type(lock.at) == "number"
				and now - lock.at < LOCK_TTL
			then
				rejected = `Your save is still open in another server. Try again in {LOCK_TTL - (now - lock.at)}s.`
				return nil -- returning nil aborts the write, leaving the claim alone
			end

			record.__lock = { server = SERVER_ID, at = now }
			return record
		end)
	end)

	if not ok then
		-- A DataStore outage must not become a dupe window, so this fails closed.
		return { ok = false, reason = `Could not reach the save servers: {err}`, data = nil }
	end
	if rejected then
		return { ok = false, reason = rejected, data = nil }
	end

	held[key] = true

	local read, record = pcall(function()
		return store:GetAsync(key)
	end)
	local data = if read and type(record) == "table" then record.data else nil
	return { ok = true, reason = nil, data = data }
end

-- Writes the player's progress alongside the claim, refreshing it in the same
-- call so an active session never has its claim expire underneath it.
function SessionLock.save(store: DataStore, key: string, data: any): boolean
	if not held[key] then
		-- We do not own this key any more. Writing would clobber whichever server
		-- does own it, which is the dupe running in reverse.
		return false
	end

	local ok, err = pcall(function()
		store:UpdateAsync(key, function(record)
			record = if type(record) == "table" then record else {}
			local lock = record.__lock
			if type(lock) == "table" and lock.server ~= SERVER_ID and os.time() - lock.at < LOCK_TTL then
				return nil -- somebody took it while we were away; do not overwrite
			end
			record.data = data
			record.__lock = { server = SERVER_ID, at = os.time() }
			return record
		end)
	end)

	if not ok then
		warn(`[SessionLock] Save failed for {key}: {err}`)
	end
	return ok
end

-- Drops the claim so the player can rejoin somewhere else immediately, instead
-- of waiting out the TTL.
function SessionLock.release(store: DataStore, key: string, data: any?)
	if not held[key] then
		return
	end

	pcall(function()
		store:UpdateAsync(key, function(record)
			record = if type(record) == "table" then record else {}
			local lock = record.__lock
			if type(lock) == "table" and lock.server ~= SERVER_ID then
				return nil
			end
			if data ~= nil then
				record.data = data
			end
			record.__lock = nil
			return record
		end)
	end)

	held[key] = nil
end

function SessionLock.holds(key: string): boolean
	return held[key] == true
end

function SessionLock.serverId(): string
	return SERVER_ID
end

--[[
	Keeps every claim this server holds alive. Without this a session longer than
	LOCK_TTL would look abandoned, and another server could take the save out from
	under a player who is still playing.
]]
function SessionLock.startHeartbeat(store: DataStore)
	task.spawn(function()
		while true do
			task.wait(REFRESH_INTERVAL)
			for key in held do
				pcall(function()
					store:UpdateAsync(key, function(record)
						record = if type(record) == "table" then record else {}
						local lock = record.__lock
						if type(lock) == "table" and lock.server ~= SERVER_ID then
							-- Lost it. Stop pretending we hold it.
							held[key] = nil
							return nil
						end
						record.__lock = { server = SERVER_ID, at = os.time() }
						return record
					end)
				end)
			end
		end
	end)
end

return SessionLock
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
