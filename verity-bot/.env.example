# ── Discord ────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Same page → General Information → Application ID
DISCORD_CLIENT_ID=
# Optional. Set this to your test server's ID and slash commands register
# there instantly instead of globally (global registration takes up to an hour).
DISCORD_DEV_GUILD_ID=

# Who may use slash commands. Comma separated, usernames or user IDs.
# IDs are safer — a username can be changed by its owner and whoever claims
# the old name would inherit access. Turn on Developer Mode in Discord, then
# right-click a member to Copy User ID.
# This also governs the verity… prefix commands (veritysong and the rest):
# nobody else can use them until you add that person or role with
# /verity dj add. Leave blank to let everyone use everything.
VERITY_OWNERS=areajoo,dangcanss
# Commands the allowlist does NOT apply to, if you want to hand one back to
# the channel without opening all of them, e.g. ask,prophecy
VERITY_OPEN_COMMANDS=

# ── Which AI answers ───────────────────────────────────────────────────────
# 'claude'  → Anthropic, uses ANTHROPIC_API_KEY below (paid, no free tier)
# 'openai'  → any OpenAI-compatible endpoint: Gemini, Groq, OpenRouter,
#             Cerebras, Mistral, a local Ollama, or OpenAI itself
VERITY_PROVIDER=claude

# --- if VERITY_PROVIDER=claude ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- if VERITY_PROVIDER=openai ---
# Your key for whichever service you picked.
VERITY_API_KEY=
# Google Gemini (free tier) — verified working:
#   VERITY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   VERITY_MODEL=gemini-3.6-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Groq:        https://api.groq.com/openai/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Cerebras:    https://api.cerebras.ai/v1
# Ollama:      http://localhost:11434/v1   (run `npm run local` to set this up)
VERITY_BASE_URL=

# ── Optional tuning ────────────────────────────────────────────────────────
# Which model Verity thinks with. A comma-separated fallback chain, best
# first: free tiers meter PER MODEL and per day, so when the first one runs
# out of budget he steps to the next instead of going silent. On Gemini's free
# tier gemini-3.6-flash allows only 20 requests a day, while the flash-lite
# models allow far more — so lead with the clever one and fall back to the
# roomy ones. Model names change often; `npm run models` prints what your key
# currently accepts.
VERITY_MODEL=claude-opus-5
# Max tokens per reply. Defaults to 700 on Claude and 2000 on the
# OpenAI-compatible path — reasoning models (Gemini 3.x) spend this budget on
# internal thinking before they write a word, and a low ceiling means Verity
# gets cut off mid-sentence or says nothing at all.
# VERITY_MAX_TOKENS=2000
# low | medium | high — how much the model deliberates. low keeps chat snappy.
# Anthropic only; ignored by OpenAI-compatible providers.
VERITY_EFFORT=low
# OpenAI-compatible only. 'low' makes Gemini think less and answer sooner.
# Left unset by default because some providers reject the parameter.
# VERITY_REASONING_EFFORT=low

# Hard ceiling on model calls per minute for the whole bot. Free tiers sit
# around 10-15 requests per minute, so this stays just under. Over the cap he
# says so once and then goes quiet rather than repeating himself.
VERITY_MAX_RPM=8

# Answered questions each person gets per window, and how long that window is.
# Set the limit to 0 for no limit. Also changeable live with /verity config.
# Only answer messages that are actually asking him something, and never
# chime in otherwise. Worth turning on when replies are expensive or slow.
VERITY_QUESTIONS_ONLY=false

# ── Music ──────────────────────────────────────────────────────────────────
# Opus bitrate. 'auto' follows the voice channel's own setting, which is what
# actually limits what listeners hear: 64000 on a normal server, up to 384000
# on a boosted one (Server Settings > the channel > Bitrate). Encoding above
# the channel just wastes CPU; below it throws quality away for nothing.
# Override with a number or "128k" if you want to pin it.
VERITY_BITRATE=auto

# Where audio comes from for links that are not already audio (YouTube pages,
# Spotify links, plain searches). Leave blank and he plays direct audio files,
# radio streams and local files only — no extra software needed for those.
# Set to `true` if yt-dlp is on your PATH, or give the full path to it.
VERITY_YTDLP=

# Optional, and FREE — no Premium needed, any Spotify account can make an app
# at https://developer.spotify.com/dashboard in about two minutes.
# Without them he reads titles and playlists off Spotify's public pages, which
# works but breaks whenever Spotify redesigns them. With them he uses the API.
VERITY_SPOTIFY_ID=
VERITY_SPOTIFY_SECRET=

VERITY_QUESTION_LIMIT=10
VERITY_QUOTA_HOURS=24
# How many messages of a channel he keeps in his head.
VERITY_MEMORY_TURNS=14
# Where per-server settings are written.
VERITY_DATA_DIR=data
# Everything Verity says is public by default, command confirmations included.
# Set this to false to make admin notices visible only to whoever ran them.
VERITY_PUBLIC_REPLIES=true
